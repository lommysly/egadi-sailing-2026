rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOrganizer() {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/egadi-2026).data.organizerIds;
    }

    function isSkipper(boatId) {
      return signedIn() && get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid;
    }

    function isInviteHolder(boatId, inviteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.participantUid == request.auth.uid;
    }

    function isBoatParticipant(boatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId)/participantAccess/$(request.auth.uid));
    }

    function canClaimInvite() {
      return signedIn()
        && request.resource.data.participantUid == request.auth.uid
        && request.resource.data.status == 'opened'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUid', 'status', 'acceptedAt']);
    }

    match /events/egadi-2026 {
      allow read: if signedIn();
      allow write: if isOrganizer();
    }

    match /boats/{boatId} {
      allow read: if isOrganizer() || resource.data.skipperId == request.auth.uid;
      allow create: if signedIn() && boatId == request.auth.uid && request.resource.data.skipperId == request.auth.uid;
      allow update: if isOrganizer() || (isSkipper(boatId)
        && request.resource.data.skipperId == resource.data.skipperId
        && request.resource.data.eventId == resource.data.eventId);
      allow delete: if isOrganizer();

      match /invites/{inviteId} {
        // Il codice a 192 bit nel link WhatsApp è la chiave personale dell'invito.
        // Gli inviti non sono elencabili: si può leggere solo conoscendo il codice esatto.
        allow get: if signedIn();
        allow list: if isOrganizer() || isSkipper(boatId);
        allow create: if (isOrganizer() || isSkipper(boatId)) && request.resource.data.boatId == boatId;
        allow delete: if isOrganizer() || isSkipper(boatId);
        allow update: if isOrganizer() || isSkipper(boatId) || canClaimInvite();
      }

      match /members/{memberId} {
        allow read: if isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId);
        allow create: if isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId);
        allow update: if isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId);
        allow delete: if isOrganizer() || isSkipper(boatId);
      }

      match /paymentRequests/{requestId} {
        allow read: if isOrganizer() || isSkipper(boatId) || (resource.data.recipientId is string && isInviteHolder(boatId, resource.data.recipientId));
        allow create, update: if isOrganizer() || isSkipper(boatId);
        allow delete: if isOrganizer();
      }

      match /participantAccess/{userId} {
        allow get: if isOrganizer() || isSkipper(boatId) || (signedIn() && userId == request.auth.uid);
        allow list: if isOrganizer() || isSkipper(boatId) || (signedIn() && resource.data.userId == request.auth.uid);
        allow create, update: if signedIn() && userId == request.auth.uid
          && request.resource.data.inviteId is string
          && request.resource.data.userId == request.auth.uid
          && request.resource.data.boatId == boatId
          && isInviteHolder(boatId, request.resource.data.inviteId);
        allow delete: if isOrganizer() || isSkipper(boatId);
      }

      match /briefing/{briefingId} {
        allow read: if isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId);
        allow create, update, delete: if isOrganizer() || isSkipper(boatId);
      }

      match /announcements/{announcementId} {
        allow read: if isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId);
        allow create, update, delete: if isOrganizer() || isSkipper(boatId);
      }

      match /ruleAcceptances/{inviteId} {
        allow get: if isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId);
        allow list: if isOrganizer() || isSkipper(boatId);
        allow create: if isOrganizer() || isSkipper(boatId) || (isInviteHolder(boatId, inviteId)
          && request.resource.data.inviteId == inviteId
          && request.resource.data.acceptedBy == request.auth.uid);
        allow update: if isOrganizer() || isSkipper(boatId) || (isInviteHolder(boatId, inviteId)
          && resource.data.inviteId == inviteId
          && resource.data.acceptedBy == request.auth.uid
          && request.resource.data.inviteId == inviteId
          && request.resource.data.acceptedBy == request.auth.uid);
        allow delete: if isOrganizer() || isSkipper(boatId);

        match /history/{versionId} {
          allow get: if isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId);
          allow list: if isOrganizer() || isSkipper(boatId);
          allow create, update: if isOrganizer() || isSkipper(boatId) || (isInviteHolder(boatId, inviteId)
            && request.resource.data.inviteId == inviteId
            && request.resource.data.acceptedBy == request.auth.uid);
          allow delete: if isOrganizer() || isSkipper(boatId);
        }
      }
    }
  }
}
