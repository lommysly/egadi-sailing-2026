rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordCrew() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string;
    }

    function isGoogleSkipperAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOrganizer() {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/egadi-2026).data.organizerIds;
    }

    // L'area privata resta negata di default. Il titolare la apre soltanto
    // dopo informativa definitiva, test Rules e test browser separati.
    function isPrivateAreaOpen() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.privateAreaEnabled == true;
    }

    // Interruttore indipendente: la vetrina pubblica può essere spenta senza
    // toccare gli accessi privati di skipper ed equipaggi.
    function isPublicFleetEnabled() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.publicFleetEnabled == true;
    }

    // Google resta obbligatorio per registrare una nuova barca. Per una barca
    // già esistente l'autorizzazione deriva invece dall'UID Firebase scritto
    // nella barca: è stabile anche se il titolare ha collegato un secondo
    // metodo di accesso, mentre un equipaggio non può mai assumere quell'UID.
    function isSkipper(boatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId))
        && get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid;
    }

    function isInviteHolder(boatId, inviteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.status == 'active'
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.participantUid == request.auth.uid;
    }

    function isBoundedText(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function isRequiredText(value, maxLength) {
      return isBoundedText(value, maxLength) && value.size() > 0;
    }

    // Anche nella bozza il nome visualizzato non e' libero: deriva dai due
    // campi disponibili, senza spazi finali quando manca uno dei due valori.
    function hasValidDraftMemberDisplayName() {
      return isBoundedText(request.resource.data.displayName, 161)
        && ((request.resource.data.firstName == ''
            && request.resource.data.lastName == ''
            && request.resource.data.displayName == '')
          || (request.resource.data.firstName != ''
            && request.resource.data.lastName == ''
            && request.resource.data.displayName == request.resource.data.firstName)
          || (request.resource.data.firstName == ''
            && request.resource.data.lastName != ''
            && request.resource.data.displayName == request.resource.data.lastName)
          || (request.resource.data.firstName != ''
            && request.resource.data.lastName != ''
            && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName));
    }

    // L'invito puo' essere rigenerato con lo stesso ID ma una nuova versione.
    // La bozza resta quindi vincolata sia all'UID che alla versione che l'ha
    // creata, per non esporre dati del precedente destinatario.
    function hasCurrentCrewDraftAudience(boatId, inviteId, draft) {
      let invite = get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data;
      return draft.keys().hasAll(['participantUid', 'accessVersion'])
        && draft.participantUid == request.auth.uid
        && draft.accessVersion is int
        && ((invite.keys().hasAll(['accessVersion'])
            && invite.accessVersion is int
            && draft.accessVersion == invite.accessVersion)
          || (!invite.keys().hasAll(['accessVersion'])
            && draft.accessVersion == 0));
    }

    // La riemissione mantiene lo stesso inviteId, ma sostituisce il
    // destinatario. La bozza precedente viene quindi eliminata nello stesso
    // batch: lo skipper non la legge e il nuovo invitato non la eredita.
    function isCrewDraftCleanupDuringInviteReissue(boatId, inviteId) {
      let before = get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data;
      let after = getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data;
      return isSkipper(boatId)
        && after.keys().hasAll(['status', 'participantUid', 'accessVersion', 'reissuedAt', 'reissuedBy'])
        && after.status == 'pending'
        && after.participantUid == null
        && after.accessVersion is int
        && after.reissuedAt == request.time
        && after.reissuedBy == request.auth.uid
        && ((before.keys().hasAll(['accessVersion'])
            && before.accessVersion is int
            && after.accessVersion == before.accessVersion + 1)
          || (!before.keys().hasAll(['accessVersion'])
            && after.accessVersion == 1));
    }

    // /members è la Crew List definitiva: una bozza vive nel percorso
    // separato /crewDrafts e non può mai comparire nel PDF del charter.
    function hasValidMemberPayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy'])
        && isRequiredText(request.resource.data.firstName, 80)
        && isRequiredText(request.resource.data.lastName, 80)
        && isIsoDate(request.resource.data.birthDate)
        && isRequiredText(request.resource.data.birthPlace, 100)
        && isRequiredText(request.resource.data.nationality, 80)
        && request.resource.data.gender in ['F', 'M', 'Altro']
        && request.resource.data.documentType in ['Carta d\'identità', 'Passaporto', 'Patente nautica', 'Altro']
        && isRequiredText(request.resource.data.documentNumber, 60)
        && isIsoDate(request.resource.data.documentExpiry)
        && isRequiredText(request.resource.data.role, 100)
        && (!request.resource.data.keys().hasAll(['roleConfirmed']) || request.resource.data.roleConfirmed is bool)
        && isBoundedText(request.resource.data.email, 160)
        && isBoundedText(request.resource.data.phone, 40)
        && request.resource.data.charterConsent == true
        && isRequiredText(request.resource.data.displayName, 161)
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && (!request.resource.data.keys().hasAll(['updatedBy']) || request.resource.data.updatedBy is string)
        && request.resource.data.updatedAt == request.time;
    }

    // La bozza della persona è privata all'invitato. Mantiene tutti i campi
    // attesi, ma consente stringhe vuote: nessun campo supplementare (file,
    // pagamenti o istruzioni) può essere inserito in questo documento.
    function hasValidCrewDraftPayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'email', 'phone', 'charterConsent', 'displayName', 'participantUid', 'accessVersion', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'email', 'phone', 'charterConsent', 'displayName', 'participantUid', 'accessVersion', 'updatedAt', 'updatedBy'])
        && isBoundedText(request.resource.data.firstName, 80)
        && isBoundedText(request.resource.data.lastName, 80)
        && isOptionalIsoDate(request.resource.data.birthDate)
        && isBoundedText(request.resource.data.birthPlace, 100)
        && isBoundedText(request.resource.data.nationality, 80)
        && request.resource.data.gender in ['', 'F', 'M', 'Altro']
        && request.resource.data.documentType in ['', 'Carta d\'identità', 'Passaporto', 'Patente nautica', 'Altro']
        && isBoundedText(request.resource.data.documentNumber, 60)
        && isOptionalIsoDate(request.resource.data.documentExpiry)
        && isBoundedText(request.resource.data.role, 100)
        && isBoundedText(request.resource.data.email, 160)
        && isBoundedText(request.resource.data.phone, 40)
        && request.resource.data.charterConsent is bool
        && hasValidDraftMemberDisplayName()
        && request.resource.data.participantUid == request.auth.uid
        && request.resource.data.accessVersion is int
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidOwnerMemberCreate() {
      return hasValidMemberPayload()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidOwnerMemberUpdate() {
      return hasValidMemberPayload()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt']);
    }

    function isValidCrewMemberCreate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasCurrentBriefingAcceptance(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.keys().hasAll(['roleConfirmed'])
        && request.resource.data.roleConfirmed == false
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasSafeCrewRoleConfirmation() {
      return (request.resource.data.role == resource.data.role
          && ((!resource.data.keys().hasAll(['roleConfirmed']) && !request.resource.data.keys().hasAll(['roleConfirmed']))
            || (resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == resource.data.roleConfirmed)
            || (!resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == false)))
        || (request.resource.data.role != resource.data.role
          && request.resource.data.keys().hasAll(['roleConfirmed'])
          && request.resource.data.roleConfirmed == false);
    }

    function isValidCrewMemberUpdate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasCurrentBriefingAcceptance(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && hasSafeCrewRoleConfirmation();
    }

    // Il dossier skipper raccoglie soltanto riferimenti personali e
    // abilitazioni. Le due copie consentite (patente nautica e certificato
    // radio) vivono nel percorso Storage privato, mai nella flotta o nella
    // superficie equipaggio.
    function isValidCharterDocumentStatus(value) {
      return value in ['to_prepare', 'ready', 'sent', 'confirmed'];
    }

    function isIsoDate(value) {
      return value is string
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function isOptionalIsoDate(value) {
      return value is string && (value.size() == 0 || isIsoDate(value));
    }

    function hasValidSkipperProfilePayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'email', 'phone', 'sailingLicenseNumber', 'sailingLicenseExpiry', 'radioCertificateType', 'radioCertificateNumber', 'radioCertificateExpiry', 'identityDocumentStatus', 'sailingLicenseStatus', 'radioCertificateStatus', 'charterConsent', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'email', 'phone', 'sailingLicenseNumber', 'sailingLicenseExpiry', 'radioCertificateType', 'radioCertificateNumber', 'radioCertificateExpiry', 'identityDocumentStatus', 'sailingLicenseStatus', 'radioCertificateStatus', 'charterConsent', 'updatedAt', 'updatedBy'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && isIsoDate(request.resource.data.birthDate)
        && request.resource.data.birthPlace is string
        && request.resource.data.birthPlace.size() > 0
        && request.resource.data.birthPlace.size() <= 100
        && request.resource.data.nationality is string
        && request.resource.data.nationality.size() > 0
        && request.resource.data.nationality.size() <= 80
        && request.resource.data.gender in ['F', 'M', 'Altro']
        && request.resource.data.documentType in ['Carta d\'identità', 'Passaporto', 'Patente nautica', 'Altro']
        && request.resource.data.documentNumber is string
        && request.resource.data.documentNumber.size() > 0
        && request.resource.data.documentNumber.size() <= 60
        && isIsoDate(request.resource.data.documentExpiry)
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 160
        && request.resource.data.phone is string
        && request.resource.data.phone.size() > 0
        && request.resource.data.phone.size() <= 40
        && request.resource.data.sailingLicenseNumber is string
        && request.resource.data.sailingLicenseNumber.size() > 0
        && request.resource.data.sailingLicenseNumber.size() <= 80
        && isOptionalIsoDate(request.resource.data.sailingLicenseExpiry)
        && request.resource.data.radioCertificateType in ['Certificato limitato di radiotelefonista', 'SRC', 'LRC', 'Altro certificato radio']
        && request.resource.data.radioCertificateNumber is string
        && request.resource.data.radioCertificateNumber.size() > 0
        && request.resource.data.radioCertificateNumber.size() <= 80
        && isOptionalIsoDate(request.resource.data.radioCertificateExpiry)
        && isValidCharterDocumentStatus(request.resource.data.identityDocumentStatus)
        && isValidCharterDocumentStatus(request.resource.data.sailingLicenseStatus)
        && isValidCharterDocumentStatus(request.resource.data.radioCertificateStatus)
        && request.resource.data.charterConsent == true
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Il dossier finale resta in /skipperProfile. Questa bozza vive in un
    // documento distinto, privato allo skipper, e permette di sospendere la
    // compilazione finché non sono disponibili i riferimenti dei documenti.
    function hasValidSkipperProfileDraftPayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'email', 'phone', 'sailingLicenseNumber', 'sailingLicenseExpiry', 'radioCertificateType', 'radioCertificateNumber', 'radioCertificateExpiry', 'identityDocumentStatus', 'sailingLicenseStatus', 'radioCertificateStatus', 'charterConsent', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'email', 'phone', 'sailingLicenseNumber', 'sailingLicenseExpiry', 'radioCertificateType', 'radioCertificateNumber', 'radioCertificateExpiry', 'identityDocumentStatus', 'sailingLicenseStatus', 'radioCertificateStatus', 'charterConsent', 'updatedAt', 'updatedBy'])
        && isBoundedText(request.resource.data.firstName, 80)
        && isBoundedText(request.resource.data.lastName, 80)
        && isOptionalIsoDate(request.resource.data.birthDate)
        && isBoundedText(request.resource.data.birthPlace, 100)
        && isBoundedText(request.resource.data.nationality, 80)
        && request.resource.data.gender in ['', 'F', 'M', 'Altro']
        && request.resource.data.documentType in ['', 'Carta d\'identità', 'Passaporto', 'Patente nautica', 'Altro']
        && isBoundedText(request.resource.data.documentNumber, 60)
        && isOptionalIsoDate(request.resource.data.documentExpiry)
        && isBoundedText(request.resource.data.email, 160)
        && isBoundedText(request.resource.data.phone, 40)
        && isBoundedText(request.resource.data.sailingLicenseNumber, 80)
        && isOptionalIsoDate(request.resource.data.sailingLicenseExpiry)
        && request.resource.data.radioCertificateType in ['', 'Certificato limitato di radiotelefonista', 'SRC', 'LRC', 'Altro certificato radio']
        && isBoundedText(request.resource.data.radioCertificateNumber, 80)
        && isOptionalIsoDate(request.resource.data.radioCertificateExpiry)
        && request.resource.data.identityDocumentStatus in ['', 'to_prepare', 'ready', 'sent', 'confirmed']
        && request.resource.data.sailingLicenseStatus in ['', 'to_prepare', 'ready', 'sent', 'confirmed']
        && request.resource.data.radioCertificateStatus in ['', 'to_prepare', 'ready', 'sent', 'confirmed']
        && request.resource.data.charterConsent is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Le tratte dello skipper sono una bozza operativa privata, separata sia
    // dal dossier charter sia dalla Crew List. Città, orari e bagagli non
    // vengono esposti a organizzatore, equipaggio o società transfer. Anche
    // un passaggio in auto resta privato: il sito prepara soltanto un testo
    // WhatsApp che lo skipper decide autonomamente se inviare nel gruppo.
    function isOptionalIsoTime(value) {
      return value is string
        && (value.size() == 0 || value.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$'));
    }

    function isOptionalIataAirport(value) {
      return value is string
        && (value.size() == 0 || value.matches('^[A-Z]{3}$'));
    }

    function hasValidSkipperTravelPayload(legId) {
      let transferAirport = legId == 'outbound'
        ? request.resource.data.destinationAirport
        : request.resource.data.originAirport;
      return (legId == 'outbound' || legId == 'return')
        && request.resource.data.keys().hasAll(['schemaVersion', 'transportMode', 'originCity', 'originAirport', 'destinationCity', 'destinationAirport', 'departureDate', 'departureTime', 'arrivalDate', 'arrivalTime', 'carrier', 'serviceNumber', 'luggageCount', 'bulkyLuggage', 'needsAirportMarsalaTransfer', 'airportMarsalaPlan', 'rideOfferSeats', 'rideOfferConsent', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['schemaVersion', 'transportMode', 'originCity', 'originAirport', 'destinationCity', 'destinationAirport', 'departureDate', 'departureTime', 'arrivalDate', 'arrivalTime', 'carrier', 'serviceNumber', 'luggageCount', 'bulkyLuggage', 'needsAirportMarsalaTransfer', 'airportMarsalaPlan', 'rideOfferSeats', 'rideOfferConsent', 'updatedAt', 'updatedBy'])
        && request.resource.data.schemaVersion == 2
        && request.resource.data.transportMode in ['', 'flight', 'train', 'car', 'ferry', 'other']
        && isBoundedText(request.resource.data.originCity, 100)
        && isOptionalIataAirport(request.resource.data.originAirport)
        && isBoundedText(request.resource.data.destinationCity, 100)
        && isOptionalIataAirport(request.resource.data.destinationAirport)
        && isOptionalIsoDate(request.resource.data.departureDate)
        && isOptionalIsoTime(request.resource.data.departureTime)
        && isOptionalIsoDate(request.resource.data.arrivalDate)
        && isOptionalIsoTime(request.resource.data.arrivalTime)
        && isBoundedText(request.resource.data.carrier, 100)
        && isBoundedText(request.resource.data.serviceNumber, 40)
        && request.resource.data.luggageCount is int
        && request.resource.data.luggageCount >= 0
        && request.resource.data.luggageCount <= 12
        && request.resource.data.bulkyLuggage is bool
        && request.resource.data.needsAirportMarsalaTransfer is bool
        && request.resource.data.airportMarsalaPlan in ['', 'transfer', 'independent', 'ride_offer']
        && request.resource.data.rideOfferSeats is int
        && request.resource.data.rideOfferSeats >= 0
        && request.resource.data.rideOfferSeats <= 8
        && request.resource.data.rideOfferConsent is bool
        && request.resource.data.needsAirportMarsalaTransfer == (request.resource.data.airportMarsalaPlan == 'transfer')
        && (request.resource.data.transportMode == 'flight'
          || (request.resource.data.airportMarsalaPlan == ''
            && request.resource.data.rideOfferSeats == 0
            && request.resource.data.rideOfferConsent == false))
        && (request.resource.data.airportMarsalaPlan != 'transfer'
          || (transferAirport == 'TPS' || transferAirport == 'PMO'))
        && (request.resource.data.airportMarsalaPlan != 'ride_offer'
          || ((transferAirport == 'TPS' || transferAirport == 'PMO')
            && request.resource.data.rideOfferSeats >= 1
            && request.resource.data.rideOfferConsent == true))
        && (request.resource.data.airportMarsalaPlan == 'ride_offer'
          || (request.resource.data.rideOfferSeats == 0
            && request.resource.data.rideOfferConsent == false))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidNewInvite(boatId, inviteId) {
      return request.resource.data.keys().hasAll(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'preferredLocale', 'createdAt', 'createdBy'])
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.participantUid == null
        && request.resource.data.status == 'pending'
        && request.resource.data.accessVersion == 1
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // Facoltativo soltanto per compatibilita con gli inviti creati prima
        // del selettore lingua; i nuovi client inviano sempre it oppure en.
        && (!request.resource.data.keys().hasAll(['preferredLocale'])
          || request.resource.data.preferredLocale in ['it', 'en'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    // La proiezione è il posto riservato dal solo skipper prima che esista un
    // invito. Non è una Crew List, non è pubblica e non contiene istruzioni
    // di pagamento: gli importi servono esclusivamente al preventivo privato.
    function hasValidCrewProjectionPayloadCore(projectionId) {
      return request.resource.data.keys().hasAll(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && projectionId.matches('^[a-f0-9]{48}$')
        && request.resource.data.id == projectionId
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.displayName is string
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() >= 8
        && request.resource.data.whatsappNumber.size() <= 30
        && request.resource.data.plannedRole is string
        && request.resource.data.plannedRole.size() > 0
        && request.resource.data.plannedRole.size() <= 100
        && request.resource.data.berthType in ['to_define', 'double_cabin', 'single_cabin', 'dinette', 'other']
        && request.resource.data.berthCents is int
        && request.resource.data.berthCents >= 0
        && request.resource.data.berthCents <= 1000000
        && request.resource.data.starterPackCents is int
        && request.resource.data.starterPackCents >= 0
        && request.resource.data.starterPackCents <= 1000000
        && request.resource.data.protectionInsuranceCents is int
        && request.resource.data.protectionInsuranceCents >= 0
        && request.resource.data.protectionInsuranceCents <= 1000000
        && request.resource.data.refundableDepositCents is int
        && request.resource.data.refundableDepositCents >= 0
        && request.resource.data.refundableDepositCents <= 1000000
        && request.resource.data.preferredLocale in ['it', 'en']
        && request.resource.data.contactConsent == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Compatibilità per le pagine già aperte prima del flag di partecipazione
    // ai costi. Il nuovo payload usa sempre lo schema V2 qui sotto.
    function hasValidLegacyCrewProjectionPayload(projectionId) {
      return request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && hasValidCrewProjectionPayloadCore(projectionId);
    }

    // V3 aggiunge facoltativamente il gruppo cabina. Il gruppo non contiene
    // nomi: due persone con lo stesso valore condividono la cabina doppia.
    // Il numero nel gruppo deve esistere anche nel layout della barca. Si usa
    // `getAfter` per non accettare, nello stesso batch, una cabina rimossa
    // contestualmente dalla configurazione. Il form limita il layout a 12
    // cabine doppie; oltre quel limite si nega l'assegnazione invece di
    // accettare un riferimento non rappresentabile nell'interfaccia.
    function isConfiguredDoubleCabinGroup(boatId, cabinGroupId) {
      let boat = getAfter(/databases/$(database)/documents/boats/$(boatId));
      return existsAfter(/databases/$(database)/documents/boats/$(boatId))
        && boat.data.keys().hasAll(['berthLayout'])
        && boat.data.berthLayout is map
        && boat.data.berthLayout.keys().hasAll(['doubleCabins'])
        && boat.data.berthLayout.doubleCabins is int
        && boat.data.berthLayout.doubleCabins >= 1
        && boat.data.berthLayout.doubleCabins <= 12
        && (cabinGroupId == 'double-1'
          || (boat.data.berthLayout.doubleCabins >= 2 && cabinGroupId == 'double-2')
          || (boat.data.berthLayout.doubleCabins >= 3 && cabinGroupId == 'double-3')
          || (boat.data.berthLayout.doubleCabins >= 4 && cabinGroupId == 'double-4')
          || (boat.data.berthLayout.doubleCabins >= 5 && cabinGroupId == 'double-5')
          || (boat.data.berthLayout.doubleCabins >= 6 && cabinGroupId == 'double-6')
          || (boat.data.berthLayout.doubleCabins >= 7 && cabinGroupId == 'double-7')
          || (boat.data.berthLayout.doubleCabins >= 8 && cabinGroupId == 'double-8')
          || (boat.data.berthLayout.doubleCabins >= 9 && cabinGroupId == 'double-9')
          || (boat.data.berthLayout.doubleCabins >= 10 && cabinGroupId == 'double-10')
          || (boat.data.berthLayout.doubleCabins >= 11 && cabinGroupId == 'double-11')
          || (boat.data.berthLayout.doubleCabins >= 12 && cabinGroupId == 'double-12'));
    }

    function hasCrewProjectionCabinGroupWithinBoat(boatId) {
      return !request.resource.data.keys().hasAny(['cabinGroupId'])
        || request.resource.data.cabinGroupId == ''
        || (request.resource.data.berthType == 'double_cabin'
          && request.resource.data.cabinGroupId is string
          && isConfiguredDoubleCabinGroup(boatId, request.resource.data.cabinGroupId));
    }

    function hasValidCrewProjectionPayloadV2(projectionId) {
      return request.resource.data.keys().hasAll(['contributesToCosts'])
        && request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'cabinGroupId', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'contributesToCosts', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && hasValidCrewProjectionPayloadCore(projectionId)
        && request.resource.data.contributesToCosts is bool
        && (!request.resource.data.keys().hasAny(['cabinGroupId'])
          || (request.resource.data.cabinGroupId is string
            && (request.resource.data.cabinGroupId == ''
              || request.resource.data.cabinGroupId.matches('^double-[1-9][0-9]*$'))
            && (request.resource.data.berthType == 'double_cabin'
              || request.resource.data.cabinGroupId == '')))
        && (request.resource.data.contributesToCosts == true
          || (request.resource.data.berthCents == 0
            && request.resource.data.starterPackCents == 0
            && request.resource.data.protectionInsuranceCents == 0));
    }

    // V3 dichiara se gli importi seguono la Dashboard economica oppure sono
    // un'eccezione esplicita. `pricingSnapshotAt`, quando presente, attesta
    // che l'invito ha già fissato gli importi; resta opzionale per permettere
    // la lettura e la manutenzione delle schede V3 già esistenti.
    function hasValidCrewProjectionPayloadV3(projectionId) {
      return request.resource.data.keys().hasAll(['contributesToCosts', 'pricingMode'])
        && request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'cabinGroupId', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'contributesToCosts', 'pricingMode', 'pricingSnapshotAt', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && hasValidCrewProjectionPayloadCore(projectionId)
        && request.resource.data.contributesToCosts is bool
        && request.resource.data.pricingMode is string
        && request.resource.data.pricingMode in ['dashboard', 'custom']
        && (!request.resource.data.keys().hasAny(['pricingSnapshotAt'])
          || request.resource.data.pricingSnapshotAt is timestamp)
        && (!request.resource.data.keys().hasAny(['cabinGroupId'])
          || (request.resource.data.cabinGroupId is string
            && (request.resource.data.cabinGroupId == ''
              || request.resource.data.cabinGroupId.matches('^double-[1-9][0-9]*$'))
            && (request.resource.data.berthType == 'double_cabin'
              || request.resource.data.cabinGroupId == '')))
        && (request.resource.data.contributesToCosts == true
          || (request.resource.data.berthCents == 0
            && request.resource.data.starterPackCents == 0
            && request.resource.data.protectionInsuranceCents == 0));
    }

    function hasValidCrewProjectionPayload(projectionId) {
      return hasValidCrewProjectionPayloadV2(projectionId)
        || hasValidCrewProjectionPayloadV3(projectionId);
    }

    // Ogni impronta V2/V3, anche incompleta, blocca un set legacy che potrebbe
    // cancellare il flag e quindi alterare il significato delle quote automatiche.
    function isCrewProjectionV2(data) {
      return data is map
        && data.keys().hasAny(['contributesToCosts']);
    }

    function isCrewProjectionV3(data) {
      return data is map
        && data.keys().hasAny(['pricingMode']);
    }

    function isValidCrewProjectionCreate(boatId, projectionId) {
      return !exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && (hasValidLegacyCrewProjectionPayload(projectionId)
          || (hasValidCrewProjectionPayload(projectionId)
            && hasCrewProjectionCabinGroupWithinBoat(boatId)))
        && request.resource.data.status == 'projected'
        && request.resource.data.inviteId == null
        && request.resource.data.invitedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidCrewProjectionDraftUpdate(boatId, projectionId) {
      return ((hasValidCrewProjectionPayload(projectionId)
          && hasCrewProjectionCabinGroupWithinBoat(boatId))
          || (!isCrewProjectionV2(resource.data)
            && hasValidLegacyCrewProjectionPayload(projectionId)))
        && (!isCrewProjectionV3(resource.data)
          || hasValidCrewProjectionPayloadV3(projectionId))
        && resource.data.status == 'projected'
        && resource.data.inviteId == null
        && resource.data.invitedAt == null
        && request.resource.data.status == 'projected'
        && request.resource.data.inviteId == null
        && request.resource.data.invitedAt == null
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'cabinGroupId', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'contributesToCosts', 'pricingMode', 'updatedAt', 'updatedBy']);
    }

    // Dopo l'invito l'identità e i prezzi concordati sono indipendenti dal
    // piano operativo. Il prezzo può cambiare solo in un percorso esplicito
    // che registra una nuova fotografia server-side; cambiare cabina o ruolo
    // non può quindi alterare per sbaglio l'accordo con la persona.
    function hasStableCrewProjectionInvitation(projectionId) {
      return resource.data.id == projectionId
        && resource.data.status == 'invited'
        && resource.data.inviteId == projectionId
        && resource.data.invitedAt is timestamp
        && request.resource.data.status == 'invited'
        && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.invitedAt == resource.data.invitedAt
        && request.resource.data.firstName == resource.data.firstName
        && request.resource.data.lastName == resource.data.lastName
        && request.resource.data.displayName == resource.data.displayName
        && request.resource.data.whatsappNumber == resource.data.whatsappNumber
        && request.resource.data.preferredLocale == resource.data.preferredLocale
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasFrozenCrewProjectionPricing() {
      return resource.data.keys().hasAll(['pricingSnapshotAt'])
        && resource.data.pricingSnapshotAt is timestamp;
    }

    function hasValidInvitedCrewProjectionV3(boatId, projectionId) {
      return hasValidCrewProjectionPayloadV3(projectionId)
        && hasCrewProjectionCabinGroupWithinBoat(boatId)
        && hasStableCrewProjectionInvitation(projectionId);
    }

    // Piano ordinario: ruolo, sistemazione e cabina possono evolvere, mentre
    // importi, modalità di prezzo e partecipazione ai costi restano fissi.
    function isValidCrewProjectionInvitedPlanUpdate(boatId, projectionId) {
      return hasValidInvitedCrewProjectionV3(boatId, projectionId)
        && isCrewProjectionV3(resource.data)
        && hasFrozenCrewProjectionPricing()
        && request.resource.data.pricingSnapshotAt == resource.data.pricingSnapshotAt
        && request.resource.data.pricingMode == resource.data.pricingMode
        && request.resource.data.contributesToCosts == resource.data.contributesToCosts
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plannedRole', 'berthType', 'cabinGroupId', 'contactConsent', 'updatedAt', 'updatedBy']);
    }

    // Le card V1/V2 o V3 senza marcatore vengono allineate una volta senza
    // cambiare nessun importo. È una migrazione compatibile, non un refresh
    // della dashboard o una nuova richiesta di denaro.
    function isValidCrewProjectionInvitedSnapshotMigration(boatId, projectionId) {
      return hasValidInvitedCrewProjectionV3(boatId, projectionId)
        && !hasFrozenCrewProjectionPricing()
        && request.resource.data.pricingSnapshotAt == request.time
        && request.resource.data.berthCents == resource.data.berthCents
        && request.resource.data.starterPackCents == resource.data.starterPackCents
        && request.resource.data.protectionInsuranceCents == resource.data.protectionInsuranceCents
        && request.resource.data.refundableDepositCents == resource.data.refundableDepositCents
        && (!resource.data.keys().hasAny(['contributesToCosts'])
          ? request.resource.data.contributesToCosts == true
          : request.resource.data.contributesToCosts == resource.data.contributesToCosts)
        && (!resource.data.keys().hasAny(['pricingMode'])
          ? request.resource.data.pricingMode == 'custom'
          : request.resource.data.pricingMode == resource.data.pricingMode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plannedRole', 'berthType', 'cabinGroupId', 'contactConsent', 'contributesToCosts', 'pricingMode', 'pricingSnapshotAt', 'updatedAt', 'updatedBy']);
    }

    // Il pulsante ⟳ applica la dashboard corrente solo alle card che la seguono
    // già. Può anche essere il primo marcatore per una card V3 storica; non
    // permette di modificare ruolo, posto o partecipazione ai costi.
    function isValidCrewProjectionInvitedDashboardPricingRefresh(boatId, projectionId) {
      return hasValidInvitedCrewProjectionV3(boatId, projectionId)
        && isCrewProjectionV3(resource.data)
        && resource.data.pricingMode == 'dashboard'
        && request.resource.data.pricingMode == 'dashboard'
        && request.resource.data.contributesToCosts == resource.data.contributesToCosts
        && request.resource.data.pricingSnapshotAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'pricingSnapshotAt', 'updatedAt', 'updatedBy']);
    }

    // L'icona € apre una revisione dichiarata della quota: resta separata
    // dalla modifica del posto e converte l'accordo in eccezione personale.
    function isValidCrewProjectionInvitedCustomPricingUpdate(boatId, projectionId) {
      return hasValidInvitedCrewProjectionV3(boatId, projectionId)
        && request.resource.data.pricingMode == 'custom'
        && (!resource.data.keys().hasAny(['contributesToCosts'])
          ? request.resource.data.contributesToCosts == true
          : request.resource.data.contributesToCosts == resource.data.contributesToCosts)
        && request.resource.data.pricingSnapshotAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'contributesToCosts', 'pricingMode', 'pricingSnapshotAt', 'updatedAt', 'updatedBy']);
    }

    function isValidCrewProjectionInvitedUpdate(boatId, projectionId) {
      return isValidCrewProjectionInvitedPlanUpdate(boatId, projectionId)
        || isValidCrewProjectionInvitedSnapshotMigration(boatId, projectionId)
        || isValidCrewProjectionInvitedDashboardPricingRefresh(boatId, projectionId)
        || isValidCrewProjectionInvitedCustomPricingUpdate(boatId, projectionId);
    }

    // Il collegamento diventa reale solo nel batch che crea l'invito con lo
    // stesso ID. `!exists` impedisce di agganciare una proiezione a un invito
    // già esistente o a un record appartenente a un altro flusso.
    function hasMatchingCrewProjectionInviteAfter(boatId, projectionId) {
      return !exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && existsAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.id == projectionId
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.boatId == boatId
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.displayName == request.resource.data.displayName
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.whatsappNumber == request.resource.data.whatsappNumber;
    }

    function isValidCrewProjectionInviteTransition(boatId, projectionId) {
      return hasValidCrewProjectionPayloadV3(projectionId)
        && hasCrewProjectionCabinGroupWithinBoat(boatId)
        && resource.data.id == projectionId
        && resource.data.status == 'projected'
        && resource.data.inviteId == null
        && resource.data.invitedAt == null
        && request.resource.data.status == 'invited'
        && request.resource.data.inviteId == projectionId
        && request.resource.data.invitedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.pricingSnapshotAt == request.time
        && (!resource.data.keys().hasAny(['contributesToCosts'])
          ? request.resource.data.contributesToCosts == true
          : request.resource.data.contributesToCosts == resource.data.contributesToCosts)
        && (!resource.data.keys().hasAny(['pricingMode'])
          ? request.resource.data.pricingMode == 'custom'
          : request.resource.data.pricingMode == resource.data.pricingMode)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteId', 'invitedAt', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'contributesToCosts', 'pricingMode', 'pricingSnapshotAt', 'updatedAt', 'updatedBy'])
        && hasMatchingCrewProjectionInviteAfter(boatId, projectionId);
    }

    // Un invito creato prima del Piano può essere collegato soltanto creando
    // una proiezione con il suo stesso ID. L'invito viene solo letto: non
    // viene riemesso, aggiornato o sostituito dal collegamento.
    function hasMatchingExistingCrewProjectionInvite(boatId, projectionId) {
      let invite = get(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId));
      return exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && invite.data.id == projectionId
        && invite.data.boatId == boatId
        && (invite.data.displayName == request.resource.data.displayName
          || (invite.data.displayName.matches('^[^ ]+$')
            && invite.data.displayName == request.resource.data.firstName))
        && invite.data.whatsappNumber == request.resource.data.whatsappNumber
        && invite.data.createdAt is timestamp
        && request.resource.data.invitedAt == invite.data.createdAt
        && (invite.data.status == 'active'
          || (invite.data.status == 'pending'
            && invite.data.expiresAt is timestamp
            && invite.data.expiresAt > request.time
            && invite.data.accessKey is string
            && invite.data.accessKey.size() == 48));
    }

    function isValidCrewProjectionLegacyInviteCreate(boatId, projectionId) {
      return (hasValidLegacyCrewProjectionPayload(projectionId)
          || (hasValidCrewProjectionPayload(projectionId)
            && hasCrewProjectionCabinGroupWithinBoat(boatId)))
        && request.resource.data.status == 'invited'
        && request.resource.data.inviteId == projectionId
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && hasMatchingExistingCrewProjectionInvite(boatId, projectionId);
    }

    function canClaimInvite(boatId, inviteId) {
      return isPasswordCrew()
        && resource.data.id == inviteId
        && resource.data.boatId == boatId
        && resource.data.status == 'pending'
        && resource.data.participantUid == null
        && resource.data.expiresAt > request.time
        && resource.data.loginEmail == request.auth.token.email
        && request.resource.data.participantUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUid', 'status', 'activatedAt']);
    }

    function canReissueInvite(boatId, inviteId) {
      return resource.data.id == inviteId
        && resource.data.boatId == boatId
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.status == 'pending'
        && request.resource.data.participantUid == null
        && request.resource.data.accessVersion is int
        && ((resource.data.keys().hasAll(['accessVersion'])
          && resource.data.accessVersion is int
          && request.resource.data.accessVersion == resource.data.accessVersion + 1)
          || (!resource.data.keys().hasAll(['accessVersion'])
            && request.resource.data.accessVersion == 1))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && (!request.resource.data.keys().hasAll(['preferredLocale'])
          || request.resource.data.preferredLocale in ['it', 'en'])
        && request.resource.data.reissuedAt == request.time
        && request.resource.data.reissuedBy == request.auth.uid
        // Se esiste una bozza del precedente destinatario, la riemissione
        // deve eliminarla nello stesso batch. Così un client vecchio non può
        // lasciare dati personali orfani e non più raggiungibili.
        && (!exists(/databases/$(database)/documents/boats/$(boatId)/crewDrafts/$(inviteId))
          || !existsAfter(/databases/$(database)/documents/boats/$(boatId)/crewDrafts/$(inviteId)))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'preferredLocale', 'activatedAt', 'reissuedAt', 'reissuedBy']);
    }

    function isCurrentCrewAccess(userId) {
      return signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && resource.data.loginEmail == request.auth.token.email
        && resource.data.boatId is string
        && resource.data.inviteId is string
        && isInviteHolder(resource.data.boatId, resource.data.inviteId);
    }

    function isValidCrewAccess(userId) {
      return isPasswordCrew()
        && userId == request.auth.uid
        && request.resource.data.keys().hasAll(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId is string
        && request.resource.data.inviteId is string
        && request.resource.data.updatedAt == request.time
        && isInviteHolder(request.resource.data.boatId, request.resource.data.inviteId);
    }

    function isBoatParticipant(boatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/crewAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.boatId == boatId
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.userId == request.auth.uid
        && isInviteHolder(boatId, get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.inviteId);
    }

    function canWriteCrewLoginIndex(phoneFingerprint) {
      let access = get(/databases/$(database)/documents/crewAccess/$(request.auth.uid));
      let invite = get(/databases/$(database)/documents/boats/$(access.data.boatId)/invites/$(access.data.inviteId));
      return isPasswordCrew()
        && access.data.userId == request.auth.uid
        && access.data.loginEmail == request.auth.token.email
        && invite.data.status == 'active'
        && invite.data.participantUid == request.auth.uid
        && invite.data.phoneFingerprint == phoneFingerprint
        && request.resource.data.keys().hasAll(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId == access.data.boatId
        && request.resource.data.inviteId == access.data.inviteId
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRuleAcceptance(boatId, inviteId) {
      return isInviteHolder(boatId, inviteId)
        && hasPublishedBriefing(boatId)
        && request.resource.data.keys().hasOnly(['inviteId', 'acceptedBy', 'rulesVersion', 'fullRulesRead', 'acceptedLocale', 'acceptedAt'])
        && request.resource.data.inviteId == inviteId
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.rulesVersion is int
        && (!request.resource.data.keys().hasAll(['fullRulesRead']) || request.resource.data.fullRulesRead == true)
        && (!request.resource.data.keys().hasAll(['acceptedLocale'])
          || request.resource.data.acceptedLocale == 'it'
          || (request.resource.data.acceptedLocale == 'en' && hasOfficialEnglishBriefing(boatId)))
        && (!briefingRequiresFullRulesRead(boatId)
          || (request.resource.data.keys().hasAll(['fullRulesRead']) && request.resource.data.fullRulesRead == true))
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.rulesVersion == get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion;
    }

    // Un invito attivo non basta per comparire nella Crew List: prima va
    // accettata l'ultima versione del briefing pubblicato dallo skipper.
    function hasPublishedBriefing(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesText is string
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesText.size() > 0
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion is int;
    }

    // La versione inglese è un contenuto ufficiale parallelo, non una
    // traduzione automatica. È richiesta solo per un'accettazione in inglese.
    function hasOfficialEnglishBriefing(boatId) {
      let board = get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data;
      return board.keys().hasAll(['rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'scheduleNoteEn'])
        && board.rulesTitleEn is string
        && board.rulesTitleEn.size() > 0
        && board.rulesSummaryEn is string
        && board.rulesSummaryEn.size() > 0
        && board.rulesTextEn is string
        && board.rulesTextEn.size() > 0
        && board.scheduleNoteEn is string;
    }

    // Lo skipper resta responsabile del contenuto, ma non può modificare il
    // briefing già accettato senza produrre una nuova versione. I documenti
    // legacy sono ammessi soltanto in lettura: il primo salvataggio li porta
    // nel formato completo e rende obbligatoria la rilettura.
    function hasValidBoardBriefingPayload() {
      return request.resource.data.keys().hasAll(['rulesTitle', 'rulesSummary', 'rulesText', 'fullRulesRequired', 'rulesVersion', 'meetingPoint', 'boardingAt', 'departureAt', 'returnAt', 'scheduleNote', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['rulesTitle', 'rulesSummary', 'rulesText', 'rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'fullRulesRequired', 'rulesVersion', 'meetingPoint', 'boardingAt', 'departureAt', 'returnAt', 'scheduleNote', 'scheduleNoteEn', 'updatedAt', 'updatedBy'])
        && request.resource.data.rulesTitle is string
        && request.resource.data.rulesTitle.size() > 0
        && request.resource.data.rulesTitle.size() <= 120
        && request.resource.data.rulesSummary is string
        && request.resource.data.rulesSummary.size() > 0
        && request.resource.data.rulesSummary.size() <= 1800
        && request.resource.data.rulesText is string
        && request.resource.data.rulesText.size() > 0
        && request.resource.data.rulesText.size() <= 9000
        && request.resource.data.fullRulesRequired == true
        && request.resource.data.rulesVersion is int
        && request.resource.data.rulesVersion > 0
        && request.resource.data.meetingPoint is string
        && request.resource.data.meetingPoint.size() <= 160
        && request.resource.data.boardingAt is string
        && request.resource.data.boardingAt.size() <= 40
        && request.resource.data.departureAt is string
        && request.resource.data.departureAt.size() <= 40
        && request.resource.data.returnAt is string
        && request.resource.data.returnAt.size() <= 40
        && request.resource.data.scheduleNote is string
        && request.resource.data.scheduleNote.size() <= 400
        && (!request.resource.data.keys().hasAll(['rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'scheduleNoteEn'])
          || (request.resource.data.rulesTitleEn is string
            && request.resource.data.rulesTitleEn.size() <= 120
            && request.resource.data.rulesSummaryEn is string
            && request.resource.data.rulesSummaryEn.size() <= 1800
            && request.resource.data.rulesTextEn is string
            && request.resource.data.rulesTextEn.size() <= 9000
            && request.resource.data.scheduleNoteEn is string
            && request.resource.data.scheduleNoteEn.size() <= 400
            && ((request.resource.data.rulesTitleEn.size() == 0
                && request.resource.data.rulesSummaryEn.size() == 0
                && request.resource.data.rulesTextEn.size() == 0
                && request.resource.data.scheduleNoteEn.size() == 0)
              || (request.resource.data.rulesTitleEn.size() > 0
                && request.resource.data.rulesSummaryEn.size() > 0
                && request.resource.data.rulesTextEn.size() > 0))))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Solo il regolamento è soggetto a rilettura. Ritrovo, orari e nota
    // operativa sono bacheca del viaggio: possono cambiare senza invalidare
    // una conferma già data su sicurezza e vita a bordo.
    function rulesContentHasChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['rulesTitle', 'rulesSummary', 'rulesText', 'rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'fullRulesRequired']);
    }

    function hasValidBoardVersionUpdate() {
      return (resource.data.keys().hasAll(['rulesVersion'])
          && resource.data.rulesVersion is int
          && ((rulesContentHasChanged() && request.resource.data.rulesVersion == resource.data.rulesVersion + 1)
            || (!rulesContentHasChanged() && request.resource.data.rulesVersion == resource.data.rulesVersion)))
        || (!resource.data.keys().hasAll(['rulesVersion']) && request.resource.data.rulesVersion == 1);
    }

    function isValidBoardBriefingCreate() {
      return hasValidBoardBriefingPayload()
        && request.resource.data.rulesVersion == 1;
    }

    function isValidBoardBriefingUpdate() {
      return hasValidBoardBriefingPayload()
        && hasValidBoardVersionUpdate();
    }

    function briefingRequiresFullRulesRead(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.keys().hasAll(['fullRulesRequired'])
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.fullRulesRequired == true;
    }

    function hasCurrentBriefingAcceptance(boatId, inviteId) {
      return hasPublishedBriefing(boatId)
        && exists(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.inviteId == inviteId
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.acceptedBy == request.auth.uid
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.rulesVersion == get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion
        && (!briefingRequiresFullRulesRead(boatId)
          || (get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.keys().hasAll(['fullRulesRead'])
            && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.fullRulesRead == true));
    }

    function hasValidPaymentMethodSelection(methods) {
      return methods is map
        && methods.keys().hasOnly(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && methods.keys().hasAny(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && (!methods.keys().hasAll(['paypal']) || methods.paypal == true)
        && (!methods.keys().hasAll(['satispay']) || methods.satispay == true)
        && (!methods.keys().hasAll(['revolut']) || methods.revolut == true)
        && (!methods.keys().hasAll(['bankTransfer']) || methods.bankTransfer == true);
    }

    function isHttpsPaymentLink(value) {
      return value is string
        && value.size() >= 9
        && value.size() <= 500
        && value.matches('^https://.+$');
    }

    function isValidRevolutDestination(value) {
      return isHttpsPaymentLink(value)
        || (value is string && value.matches('^@[A-Za-z0-9._-]{3,50}$'));
    }

    function hasValidBankTransferDetails(details) {
      return details is map
        && details.keys().hasAll(['iban', 'accountHolder'])
        && details.keys().hasOnly(['iban', 'accountHolder'])
        && details.iban is string
        && details.accountHolder is string
        && ((details.iban == '' && details.accountHolder == '')
          || (details.iban.matches('^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$')
            && details.accountHolder.size() >= 2
            && details.accountHolder.size() <= 100));
    }

    function hasValidPaymentDetails(details) {
      return details is map
        && details.keys().hasAll(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && details.keys().hasOnly(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && details.paypal is string
        && details.satispay is string
        && details.revolut is string
        && (details.paypal == '' || isHttpsPaymentLink(details.paypal))
        && (details.satispay == '' || isHttpsPaymentLink(details.satispay))
        && (details.revolut == '' || isValidRevolutDestination(details.revolut))
        && hasValidBankTransferDetails(details.bankTransfer);
    }

    function hasValidPrivateBoatCapacity() {
      return !request.resource.data.keys().hasAll(['totalBerths'])
        || (request.resource.data.totalBerths is int
          && request.resource.data.totalBerths >= 2
          && request.resource.data.totalBerths <= 31
          && request.resource.data.capacity is int
          && request.resource.data.capacity >= 1
          && request.resource.data.capacity <= 30
          && request.resource.data.capacity == request.resource.data.totalBerths - 1);
    }

    // Il piano quote è volutamente un elenco chiuso: non contiene contatti,
    // coordinate di pagamento o link che possano finire nell'area equipaggio.
    // Gli importi sono sempre in centesimi per persona.
    function hasValidContributionItemV1(item) {
      return item is map
        && item.keys().hasAll(['state', 'amountCents'])
        && item.keys().hasOnly(['state', 'amountCents'])
        && item.state is string
        && item.state in ['to_define', 'included', 'extra', 'local', 'not_applicable']
        && item.amountCents is int
        && item.amountCents >= 0
        && item.amountCents <= 1000000
        // Solo una voce extra o da regolare in loco può avere un importo.
        && (item.state in ['extra', 'local'] || item.amountCents == 0);
    }

    function hasValidContributionPlanV1() {
      let items = request.resource.data.items;
      return request.resource.data.keys().hasAll(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && items is map
        && items.keys().hasAll(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'refundable_deposit'])
        && items.keys().hasOnly(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'refundable_deposit'])
        && hasValidContributionItemV1(items.berth)
        && hasValidContributionItemV1(items.starter_pack)
        && hasValidContributionItemV1(items.linen_towels)
        && hasValidContributionItemV1(items.protection_insurance)
        && hasValidContributionItemV1(items.provisions)
        && hasValidContributionItemV1(items.fuel)
        && hasValidContributionItemV1(items.transfer)
        && hasValidContributionItemV1(items.refundable_deposit)
        // Lo Starter Pack di questo viaggio è sempre cash/in loco e include
        // già lenzuola e asciugamani: nessun doppio addebito o link esterno.
        && items.starter_pack.state == 'local'
        && items.linen_towels.state == 'included'
        // Una cauzione rimborsabile non è mai parte silenziosa della quota,
        // né una richiesta a distanza: si porta e si regola in loco.
        && items.refundable_deposit.state == 'local'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Descrizioni visibili all'equipaggio: servono a spiegare una voce, mai
    // a ripetere contatti o canali d'incasso. Blocchiamo URL, e-mail, numeri
    // di telefono, IBAN e metodi di pagamento anche con maiuscole/minuscole miste.
    function hasSafeCrewFacingDescription(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 320
        && !(value.matches('.*[Hh][Tt][Tt][Pp][Ss]?://.*'))
        && !(value.matches('.*[Ww][Ww][Ww][.].*'))
        && !(value.matches('.*@[A-Za-z0-9._-]+[.][A-Za-z]{2,}.*'))
        && !(value.matches('.*[A-Za-z]{2}[0-9]{2}[A-Za-z0-9]{11,30}.*'))
        && !(value.matches('.*[+]?[0-9][0-9 -]{6,}[0-9].*'))
        && !(value.matches('.*([Pp][Aa][Yy][Pp][Aa][Ll]|[Ss][Aa][Tt][Ii][Ss][Pp][Aa][Yy]|[Rr][Ee][Vv][Oo][Ll][Uu][Tt]|[Ii][Bb][Aa][Nn]|[Bb][Oo][Nn][Ii][Ff][Ii][Cc][Oo]|[Cc][Aa][Uu][Ss][Aa][Ll][Ee]).*'));
    }

    // Il preventivo barca resta leggibile soltanto allo skipper. Le note
    // storiche non vengono più propagate nel riepilogo equipaggio, quindi
    // qui basta mantenere un testo breve e non un secondo filtro pubblico
    // ad alta complessità che può bloccare il salvataggio del preventivo.
    function hasValidPrivateCostPlanNote(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 320;
    }

    // V2 aggiunge un dettaglio breve e controllato per ciascuna voce e due
    // voci operative (cena a terra e porto/ormeggio). Il testo è pensato per
    // l'equipaggio dopo il briefing, non può contenere canali d'incasso.
    function hasValidContributionItemV2(item) {
      return item is map
        && item.keys().hasAll(['state', 'amountCents', 'description'])
        && item.keys().hasOnly(['state', 'amountCents', 'description'])
        && item.state is string
        && item.state in ['to_define', 'included', 'extra', 'local', 'not_applicable']
        && item.amountCents is int
        && item.amountCents >= 0
        && item.amountCents <= 1000000
        && hasSafeCrewFacingDescription(item.description)
        && (item.state in ['extra', 'local'] || item.amountCents == 0);
    }

    function hasValidContributionPlanV2() {
      let items = request.resource.data.items;
      return request.resource.data.keys().hasAll(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && items is map
        && items.keys().hasAll(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && items.keys().hasOnly(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && hasValidContributionItemV2(items.berth)
        && hasValidContributionItemV2(items.starter_pack)
        && hasValidContributionItemV2(items.linen_towels)
        && hasValidContributionItemV2(items.protection_insurance)
        && hasValidContributionItemV2(items.provisions)
        && hasValidContributionItemV2(items.fuel)
        && hasValidContributionItemV2(items.transfer)
        && hasValidContributionItemV2(items.shore_dinner)
        && hasValidContributionItemV2(items.mooring_fee)
        && hasValidContributionItemV2(items.refundable_deposit)
        && items.starter_pack.state == 'local'
        && items.linen_towels.state == 'included'
        && items.refundable_deposit.state == 'local'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isContributionPlanV2(data) {
      return data is map
        && data.keys().hasAll(['items'])
        && data.items is map
        && data.items.keys().hasAny(['shore_dinner', 'mooring_fee']);
    }

    // V3 dichiara il trattamento mostrato all'equipaggio. La provenienza del
    // Pack (dentro o fuori charter) vive nel costPlan V7: la dashboard attuale
    // salva sempre la quota cash_on_board, senza confondere i due concetti.
    function hasValidContributionPlanV3() {
      let items = request.resource.data.items;
      return request.resource.data.keys().hasAll(['items', 'starterPackSettlementMode', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['items', 'starterPackSettlementMode', 'updatedAt', 'updatedBy'])
        && items is map
        && items.keys().hasAll(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && items.keys().hasOnly(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && hasValidContributionItemV2(items.berth)
        && hasValidContributionItemV2(items.starter_pack)
        && hasValidContributionItemV2(items.linen_towels)
        && hasValidContributionItemV2(items.protection_insurance)
        && hasValidContributionItemV2(items.provisions)
        && hasValidContributionItemV2(items.fuel)
        && hasValidContributionItemV2(items.transfer)
        && hasValidContributionItemV2(items.shore_dinner)
        && hasValidContributionItemV2(items.mooring_fee)
        && hasValidContributionItemV2(items.refundable_deposit)
        && request.resource.data.starterPackSettlementMode is string
        && request.resource.data.starterPackSettlementMode in ['included_in_charter', 'cash_on_board']
        && ((request.resource.data.starterPackSettlementMode == 'included_in_charter'
            && items.starter_pack.state == 'included'
            && items.starter_pack.amountCents == 0)
          || (request.resource.data.starterPackSettlementMode == 'cash_on_board'
            && items.starter_pack.state == 'local'))
        && items.linen_towels.state == 'included'
        && items.refundable_deposit.state == 'local'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isContributionPlanV3(data) {
      return data is map
        && data.keys().hasAny(['starterPackSettlementMode']);
    }

    // V4 elimina i testi liberi dal riepilogo dell'equipaggio. I servizi
    // compresi nello Starter Pack sono una lista chiusa, senza duplicati:
    // l'elenco può restare vuoto finché lo skipper non lo ha definito.
    function hasValidStarterPackItems(items) {
      return items is list
        && items.size() <= 9
        && items.toSet().size() == items.size()
        && items.toSet().hasOnly(['bed_linen', 'bath_towels', 'bath_kit', 'beach_towel', 'outboard', 'final_cleaning', 'sup', 'egadi_navigation_permit', 'tender']);
    }

    function hasValidContributionPlanV4() {
      let items = request.resource.data.items;
      return request.resource.data.keys().hasAll(['items', 'starterPackItems', 'starterPackSettlementMode', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['items', 'starterPackItems', 'starterPackSettlementMode', 'updatedAt', 'updatedBy'])
        && items is map
        && items.keys().hasAll(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && items.keys().hasOnly(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'refundable_deposit'])
        && hasValidContributionItemV1(items.berth)
        && hasValidContributionItemV1(items.starter_pack)
        && hasValidContributionItemV1(items.linen_towels)
        && hasValidContributionItemV1(items.protection_insurance)
        && hasValidContributionItemV1(items.provisions)
        && hasValidContributionItemV1(items.fuel)
        && hasValidContributionItemV1(items.transfer)
        && hasValidContributionItemV1(items.shore_dinner)
        && hasValidContributionItemV1(items.mooring_fee)
        && hasValidContributionItemV1(items.refundable_deposit)
        && hasValidStarterPackItems(request.resource.data.starterPackItems)
        && request.resource.data.starterPackSettlementMode == 'cash_on_board'
        && items.starter_pack.state == 'local'
        && items.linen_towels.state == 'included'
        && items.refundable_deposit.state == 'local'
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Qualsiasi marcatore V4 rende il documento canonico: una pagina cache
    // non può più rimuovere `starterPackItems` tornando al formato V1–V3.
    function isContributionPlanV4(data) {
      return data is map
        && data.keys().hasAny(['starterPackItems']);
    }

    // Il ternario evita di valutare entrambi gli schemi durante una singola
    // transazione che aggiorna anche il preventivo barca.
    function hasValidContributionPlanV3OrV4() {
      return isContributionPlanV4(request.resource.data)
        ? hasValidContributionPlanV4()
        : hasValidContributionPlanV3();
    }

    // Il preventivo barca è un prospetto privato di soli importi aggregati.
    // Non può contenere nominativi, quote individuali, note, istruzioni di
    // pagamento o una categoria per cene: non è un listino né un incasso.
    function hasValidSkipperCostPlanCore() {
      return request.resource.data.keys().hasAll(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'payingParticipants', 'updatedAt', 'updatedBy'])
        && request.resource.data.charterCents is int
        && request.resource.data.charterCents >= 0
        && request.resource.data.charterCents <= 1000000
        && request.resource.data.skipperFlightTrainCents is int
        && request.resource.data.skipperFlightTrainCents >= 0
        && request.resource.data.skipperFlightTrainCents <= 1000000
        && request.resource.data.skipperCarCents is int
        && request.resource.data.skipperCarCents >= 0
        && request.resource.data.skipperCarCents <= 1000000
        && request.resource.data.skipperLocalTransferCents is int
        && request.resource.data.skipperLocalTransferCents >= 0
        && request.resource.data.skipperLocalTransferCents <= 1000000
        && request.resource.data.otherRecoverableCents is int
        && request.resource.data.otherRecoverableCents >= 0
        && request.resource.data.otherRecoverableCents <= 1000000
        && request.resource.data.payingParticipants is int
        && request.resource.data.payingParticipants >= 1
        && request.resource.data.payingParticipants <= 30
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Compatibilità transitoria per i prospetti salvati prima del calcolatore.
    // Un documento già v2, v3 o v4 non può tornare a questo schema: una pagina
    // cache vecchia non deve poter cancellare i nuovi dati al salvataggio.
    function hasValidLegacySkipperCostPlan() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'payingParticipants', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanCore();
    }

    function hasValidSkipperCostPlanV2Core() {
      return request.resource.data.keys().hasAll(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'payingParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'updatedAt', 'updatedBy'])
        && request.resource.data.starterPackTotalCents is int
        && request.resource.data.starterPackTotalCents >= 0
        && request.resource.data.starterPackTotalCents <= 1000000
        && request.resource.data.protectionInsuranceTotalCents is int
        && request.resource.data.protectionInsuranceTotalCents >= 0
        && request.resource.data.protectionInsuranceTotalCents <= 1000000
        && request.resource.data.refundableDepositTotalCents is int
        && request.resource.data.refundableDepositTotalCents >= 0
        && request.resource.data.refundableDepositTotalCents <= 1000000
        && request.resource.data.dinettePayingParticipants is int
        && request.resource.data.dinettePayingParticipants >= 0
        && request.resource.data.dinettePayingParticipants <= request.resource.data.payingParticipants
        && request.resource.data.dinetteWeightPercent is int
        && request.resource.data.dinetteWeightPercent >= 1
        && request.resource.data.dinetteWeightPercent <= 100
        && hasValidSkipperCostPlanCore();
    }

    function hasValidSkipperCostPlanV2() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'payingParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanV2Core();
    }

    function skipperCostPlanRecoverableCents() {
      return request.resource.data.charterCents
        + request.resource.data.skipperFlightTrainCents
        + request.resource.data.skipperCarCents
        + request.resource.data.skipperLocalTransferCents
        + request.resource.data.otherRecoverableCents;
    }

    // V3 conserva la percentuale per il round-trip del calcolatore. In
    // modalità fixed, dinetteFixedCents è la quota per ogni posto dinette.
    function hasValidSkipperCostPlanV3Core() {
      return request.resource.data.keys().hasAll(['dinetteRateMode', 'dinetteFixedCents'])
        && hasValidSkipperCostPlanV2Core()
        && request.resource.data.dinetteRateMode is string
        && request.resource.data.dinetteRateMode in ['percentage', 'fixed']
        && request.resource.data.dinetteFixedCents is int
        && request.resource.data.dinetteFixedCents >= 0
        && request.resource.data.dinetteFixedCents <= 1000000
        && ((request.resource.data.dinetteRateMode == 'percentage'
            && request.resource.data.dinetteFixedCents == 0)
          || (request.resource.data.dinetteRateMode == 'fixed'
            && request.resource.data.dinetteFixedCents >= 1
            && request.resource.data.dinettePayingParticipants >= 1
            && request.resource.data.dinettePayingParticipants < request.resource.data.payingParticipants
            && request.resource.data.dinettePayingParticipants * request.resource.data.dinetteFixedCents < skipperCostPlanRecoverableCents()));
    }

    function hasValidSkipperCostPlanV3() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'payingParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'dinetteRateMode', 'dinetteFixedCents', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanV3Core();
    }

    // La cauzione può essere portata anche da co-skipper o hostess: il suo
    // divisore resta quindi indipendente da chi contribuisce ai costi barca.
    function hasValidSkipperCostPlanV4Core() {
      return request.resource.data.keys().hasAll(['depositParticipants'])
        && hasValidSkipperCostPlanV3Core()
        && request.resource.data.depositParticipants is int
        && request.resource.data.depositParticipants >= 1
        && request.resource.data.depositParticipants <= 30;
    }

    function hasValidSkipperCostPlanV4() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'payingParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'dinetteRateMode', 'dinetteFixedCents', 'depositParticipants', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanV4Core();
    }

    // V5 conserva il prospetto aggregato, ma aggiunge tre descrizioni brevi
    // da copiare nel piano quote sanificato visibile all'equipaggio dopo il
    // briefing. Non ammette canali di incasso o istruzioni di pagamento.
    function hasValidSkipperCostPlanV5Core() {
      return request.resource.data.keys().hasAll(['starterPackDescription', 'protectionInsuranceDescription', 'refundableDepositDescription'])
        && hasValidSkipperCostPlanV4Core()
        && hasSafeCrewFacingDescription(request.resource.data.starterPackDescription)
        && hasSafeCrewFacingDescription(request.resource.data.protectionInsuranceDescription)
        && hasSafeCrewFacingDescription(request.resource.data.refundableDepositDescription);
    }

    function hasValidSkipperCostPlanV5() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'payingParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'dinetteRateMode', 'dinetteFixedCents', 'depositParticipants', 'starterPackDescription', 'protectionInsuranceDescription', 'refundableDepositDescription', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanV5Core();
    }

    // V6 rende esplicito il significato delle due voci variabili. I campi
    // "totale" non vengono mai riutilizzati come quota individuale: evita
    // che una pagina vecchia divida due volte un importo fisso per persona.
    function hasValidSkipperCostPlanV6Core() {
      return request.resource.data.keys().hasAll(['starterPackRateMode', 'starterPackFixedPerPersonCents', 'starterPackIncludedInCharter', 'protectionInsuranceRateMode', 'protectionInsuranceFixedPerPersonCents'])
        && request.resource.data.starterPackRateMode is string
        && request.resource.data.starterPackRateMode in ['total_divided', 'fixed_per_person']
        && request.resource.data.starterPackFixedPerPersonCents is int
        && request.resource.data.starterPackFixedPerPersonCents >= 0
        && request.resource.data.starterPackFixedPerPersonCents <= 1000000
        && request.resource.data.starterPackIncludedInCharter is bool
        && request.resource.data.protectionInsuranceRateMode is string
        && request.resource.data.protectionInsuranceRateMode in ['total_divided', 'fixed_per_person']
        && request.resource.data.protectionInsuranceFixedPerPersonCents is int
        && request.resource.data.protectionInsuranceFixedPerPersonCents >= 0
        && request.resource.data.protectionInsuranceFixedPerPersonCents <= 1000000
        && request.resource.data.dinetteRateMode is string
        && request.resource.data.dinetteRateMode in ['percentage', 'fixed']
        && request.resource.data.dinetteFixedCents is int
        && request.resource.data.dinetteFixedCents >= 0
        && request.resource.data.dinetteFixedCents <= 1000000
        && request.resource.data.depositParticipants is int
        && request.resource.data.depositParticipants >= 1
        && request.resource.data.depositParticipants <= 30
        && hasValidPrivateCostPlanNote(request.resource.data.starterPackDescription)
        && hasValidPrivateCostPlanNote(request.resource.data.protectionInsuranceDescription)
        && hasValidPrivateCostPlanNote(request.resource.data.refundableDepositDescription)
        && ((request.resource.data.starterPackRateMode == 'total_divided'
            && request.resource.data.starterPackFixedPerPersonCents == 0)
          || (request.resource.data.starterPackRateMode == 'fixed_per_person'
            && request.resource.data.starterPackTotalCents == 0
            && request.resource.data.starterPackFixedPerPersonCents >= 1))
        && (request.resource.data.starterPackIncludedInCharter == false
          || (request.resource.data.starterPackRateMode == 'total_divided'
            && request.resource.data.starterPackTotalCents <= request.resource.data.charterCents)
          || (request.resource.data.starterPackRateMode == 'fixed_per_person'
            && request.resource.data.starterPackFixedPerPersonCents * request.resource.data.payingParticipants <= request.resource.data.charterCents))
        // Con il Pack già dentro il charter la dinette fissa deve lasciare
        // coperta anche la sola quota cabina: è lo stesso limite della UI.
        && ((request.resource.data.dinetteRateMode == 'percentage'
            && request.resource.data.dinetteFixedCents == 0)
          || (request.resource.data.dinetteRateMode == 'fixed'
            && request.resource.data.dinetteFixedCents >= 1
            && request.resource.data.dinettePayingParticipants >= 1
            && request.resource.data.dinettePayingParticipants < request.resource.data.payingParticipants
            && request.resource.data.dinettePayingParticipants * request.resource.data.dinetteFixedCents
              < (skipperCostPlanRecoverableCents()
                - (request.resource.data.starterPackIncludedInCharter
                  ? (request.resource.data.starterPackRateMode == 'fixed_per_person'
                    ? request.resource.data.starterPackFixedPerPersonCents * request.resource.data.payingParticipants
                    : request.resource.data.starterPackTotalCents)
                  : 0))))
        && ((request.resource.data.protectionInsuranceRateMode == 'total_divided'
            && request.resource.data.protectionInsuranceFixedPerPersonCents == 0)
          || (request.resource.data.protectionInsuranceRateMode == 'fixed_per_person'
            && request.resource.data.protectionInsuranceTotalCents == 0
            && request.resource.data.protectionInsuranceFixedPerPersonCents >= 1))
        // V6 usa il core V2 per i totali e i contatori condivisi. Evitiamo di
        // attraversare anche i vecchi controlli V3/V4/V5: la condizione
        // fixed sopra è più restrittiva perché considera il Pack scorporato.
        && hasValidSkipperCostPlanV2Core();
    }

    function hasValidSkipperCostPlanV6() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'starterPackRateMode', 'starterPackFixedPerPersonCents', 'starterPackIncludedInCharter', 'protectionInsuranceTotalCents', 'protectionInsuranceRateMode', 'protectionInsuranceFixedPerPersonCents', 'refundableDepositTotalCents', 'payingParticipants', 'depositParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'dinetteRateMode', 'dinetteFixedCents', 'starterPackDescription', 'protectionInsuranceDescription', 'refundableDepositDescription', 'updatedAt', 'updatedBy'])
        && hasValidSkipperCostPlanV6Core();
    }

    // V7 conserva il costo reale della barca e salva soltanto la scelta con
    // cui comunicare una quota tonda. Totali e avanzo restano derivati nel
    // browser: non diventano un falso costo charter né un campo di incasso.
    function hasValidSkipperCostPlanV7() {
      return request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'starterPackTotalCents', 'starterPackRateMode', 'starterPackFixedPerPersonCents', 'starterPackIncludedInCharter', 'protectionInsuranceTotalCents', 'protectionInsuranceRateMode', 'protectionInsuranceFixedPerPersonCents', 'refundableDepositTotalCents', 'payingParticipants', 'depositParticipants', 'dinettePayingParticipants', 'dinetteWeightPercent', 'dinetteRateMode', 'dinetteFixedCents', 'berthRoundingMode', 'berthRoundingIncrementCents', 'manualStandardBerthCents', 'starterPackDescription', 'protectionInsuranceDescription', 'refundableDepositDescription', 'updatedAt', 'updatedBy'])
        && request.resource.data.berthRoundingMode is string
        && request.resource.data.berthRoundingMode in ['automatic', 'ceil_increment', 'manual_up']
        && request.resource.data.berthRoundingIncrementCents is int
        && request.resource.data.berthRoundingIncrementCents >= 0
        && request.resource.data.berthRoundingIncrementCents <= 10000
        && request.resource.data.manualStandardBerthCents is int
        && request.resource.data.manualStandardBerthCents >= 0
        && request.resource.data.manualStandardBerthCents <= 1000000
        && ((request.resource.data.berthRoundingMode == 'automatic'
            && request.resource.data.berthRoundingIncrementCents == 0
            && request.resource.data.manualStandardBerthCents == 0)
          || (request.resource.data.berthRoundingMode == 'ceil_increment'
            && request.resource.data.berthRoundingIncrementCents in [100, 500, 1000]
            && request.resource.data.manualStandardBerthCents == 0)
          || (request.resource.data.berthRoundingMode == 'manual_up'
            && request.resource.data.berthRoundingIncrementCents == 0
            && request.resource.data.manualStandardBerthCents >= 1))
        && hasValidSkipperCostPlanV6Core();
    }

    // GitHub Pages e Firestore non hanno un rilascio atomico. Durante il
    // passaggio V6 → V7 lasciamo salvare il vecchio payload solo finché il
    // documento non ha già i marcatori V7. Una pagina cache non può quindi
    // cancellare l'arrotondamento dopo la prima migrazione riuscita.
    function isSkipperCostPlanV7(data) {
      return data is map
        && data.keys().hasAny(['berthRoundingMode', 'berthRoundingIncrementCents', 'manualStandardBerthCents']);
    }

    // La scelta del validatore con ternario evita di valutare V6 e V7 nello
    // stesso accesso. Le Rules hanno un budget massimo di espressioni anche
    // per una singola transazione con documenti diversi.
    function hasValidSkipperCostPlanV6OrV7() {
      return isSkipperCostPlanV7(request.resource.data)
        ? hasValidSkipperCostPlanV7()
        : hasValidSkipperCostPlanV6();
    }

    // Il rilevamento usa qualsiasi marcatore: anche un documento migrato a
    // metà resta bloccato dal downgrade e può essere soltanto riparato con il
    // payload completo della sua versione o di una successiva.
    function isSkipperCostPlanV2(data) {
      return data is map
        && data.keys().hasAny(['starterPackTotalCents', 'protectionInsuranceTotalCents', 'refundableDepositTotalCents', 'dinettePayingParticipants', 'dinetteWeightPercent']);
    }

    function isSkipperCostPlanV3(data) {
      return data is map
        && data.keys().hasAny(['dinetteRateMode', 'dinetteFixedCents']);
    }

    function isSkipperCostPlanV4(data) {
      return data is map
        && data.keys().hasAny(['depositParticipants']);
    }

    function isSkipperCostPlanV5(data) {
      return data is map
        && data.keys().hasAny(['starterPackDescription', 'protectionInsuranceDescription', 'refundableDepositDescription']);
    }

    function isSkipperCostPlanV6(data) {
      return data is map
        && data.keys().hasAny(['starterPackRateMode', 'starterPackFixedPerPersonCents', 'starterPackIncludedInCharter', 'protectionInsuranceRateMode', 'protectionInsuranceFixedPerPersonCents']);
    }

    // Piano quote, richieste personali e bacheca restano consultabili soltanto
    // dopo la conferma della versione corrente delle regole di bordo. Il
    // briefing rimane un percorso separato e leggibile prima, così la persona
    // può effettivamente leggerlo e accettarlo.
    function hasCurrentParticipantBriefingAcceptance(boatId) {
      return isBoatParticipant(boatId)
        && hasCurrentBriefingAcceptance(boatId,
          get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.inviteId);
    }

    function hasValidCollectionProfile() {
      return request.resource.data.keys().hasAll(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'paymentDetails', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'paymentDetails', 'updatedAt', 'updatedBy'])
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName is string
        && request.resource.data.collectorName.size() > 0
        && request.resource.data.collectorName.size() <= 100
        && request.resource.data.paypalEnabled is bool
        && request.resource.data.satispayEnabled is bool
        && request.resource.data.revolutEnabled is bool
        && request.resource.data.bankTransferEnabled is bool
        && (request.resource.data.paypalEnabled == true
          || request.resource.data.satispayEnabled == true
          || request.resource.data.revolutEnabled == true
          || request.resource.data.bankTransferEnabled == true)
        // È obbligatorio: un client precedente non può cancellare dettagli già
        // salvati riscrivendo il vecchio schema del profilo.
        && hasValidPaymentDetails(request.resource.data.paymentDetails)
        && (!request.resource.data.paypalEnabled || isHttpsPaymentLink(request.resource.data.paymentDetails.paypal))
        && (!request.resource.data.satispayEnabled || isHttpsPaymentLink(request.resource.data.paymentDetails.satispay))
        && (!request.resource.data.revolutEnabled || isValidRevolutDestination(request.resource.data.paymentDetails.revolut))
        && (!request.resource.data.bankTransferEnabled
          || (request.resource.data.paymentDetails.bankTransfer.iban != ''
            && request.resource.data.paymentDetails.bankTransfer.accountHolder != ''))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function collectionProfileExists(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default);
    }

    function inviteExists(boatId, inviteId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId));
    }

    function paymentMethodsAllowedByProfile(boatId, methods) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return hasValidPaymentDetails(profile.paymentDetails)
        && (!methods.keys().hasAll(['paypal'])
          || (profile.paypalEnabled == true && isHttpsPaymentLink(profile.paymentDetails.paypal)))
        && (!methods.keys().hasAll(['satispay'])
          || (profile.satispayEnabled == true && isHttpsPaymentLink(profile.paymentDetails.satispay)))
        && (!methods.keys().hasAll(['revolut'])
          || (profile.revolutEnabled == true && isValidRevolutDestination(profile.paymentDetails.revolut)))
        && (!methods.keys().hasAll(['bankTransfer'])
          || (profile.bankTransferEnabled == true
            && profile.paymentDetails.bankTransfer.iban != ''
            && profile.paymentDetails.bankTransfer.accountHolder != ''));
    }

    // Etichetta tecnica chiusa: serve soltanto a separare i versamenti
    // verificati che recuperano i costi della barca dalle altre richieste.
    // Non contiene causali, coordinate o istruzioni di pagamento.
    function hasValidPaymentAccountingCategory(category) {
      return category is string
        && (category == 'cost_recovery' || category == 'other');
    }

    // Identificatore chiuso della voce richiesta. Permette al destinatario di
    // distinguere la propria quota e assicurazione senza usare
    // o interpretare la causale libera del messaggio.
    function hasValidPaymentContributionItemId(itemId) {
      return itemId is string
        && itemId in ['berth_base', 'berth_double_cabin', 'berth_single_cabin', 'berth_dinette', 'berth_other', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'shore_dinner', 'mooring_fee', 'other'];
    }

    // I campi di rateizzazione non sostituiscono la causale: separano una
    // richiesta da un incasso storico e descrivono solo la posizione rispetto
    // alla quota. L'assenza resta ammessa per record e pagine legacy.
    function hasValidPaymentAllocation(allocation) {
      return allocation is map
        && allocation.keys().hasAll(['berthCents', 'protectionInsuranceCents'])
        && allocation.keys().hasOnly(['berthCents', 'protectionInsuranceCents'])
        && allocation.berthCents is int
        && allocation.berthCents >= 0
        && allocation.berthCents <= 1000000
        && allocation.protectionInsuranceCents is int
        && allocation.protectionInsuranceCents >= 0
        && allocation.protectionInsuranceCents <= 1000000
        && allocation.berthCents + allocation.protectionInsuranceCents == request.resource.data.amountCents;
    }

    function hasValidManualReceiptDate(value) {
      return value is string
        && value.size() == 10
        && value.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }

    function hasValidPaymentInstallmentFields() {
      let hasEntryType = request.resource.data.keys().hasAll(['entryType']);
      let hasInstallmentType = request.resource.data.keys().hasAll(['installmentType']);
      let hasAllocation = request.resource.data.keys().hasAll(['allocation']);
      let hasReceivedOn = request.resource.data.keys().hasAll(['receivedOn']);
      return (!hasEntryType && !hasInstallmentType && !hasAllocation && !hasReceivedOn)
        || (hasEntryType
          && hasInstallmentType
          && request.resource.data.entryType is string
          && request.resource.data.entryType in ['request', 'manual_receipt']
          && request.resource.data.installmentType is string
          && request.resource.data.installmentType in ['advance', 'balance', 'full', 'extra']
          // Le voci extra non si ripartiscono fra posto e assicurazione;
          // le rate della quota invece devono dichiarare il riparto esatto.
          && (request.resource.data.installmentType == 'extra'
            ? !hasAllocation
            : (hasAllocation && hasValidPaymentAllocation(request.resource.data.allocation)))
          && (!hasReceivedOn || hasValidManualReceiptDate(request.resource.data.receivedOn)));
    }

    function hasValidEmptyPaymentMethodSelection(methods) {
      return methods is map
        && methods.keys().size() == 0;
    }

    function hasValidPaymentRequestCore(boatId, canUseProjectionRecipient) {
      return request.resource.data.keys().hasAll(['recipientId', 'memberId', 'payerInviteId', 'amountCents', 'currency', 'reason', 'accountingCategory', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.keys().hasOnly(['recipientId', 'memberId', 'payerInviteId', 'contributionItemId', 'entryType', 'installmentType', 'allocation', 'receivedOn', 'amountCents', 'currency', 'reason', 'accountingCategory', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.memberId == request.resource.data.recipientId
        && request.resource.data.payerInviteId == request.resource.data.recipientId
        && (inviteExists(boatId, request.resource.data.recipientId)
          || (canUseProjectionRecipient
            && exists(/databases/$(database)/documents/boats/$(boatId)/crewProjections/$(request.resource.data.recipientId))))
        // Compatibilità temporanea per pagine skipper già aperte prima del
        // selettore tecnico: se la chiave è presente deve comunque essere
        // nell'enum chiuso. `refundable_deposit` non è mai ammesso online.
        && (!request.resource.data.keys().hasAll(['contributionItemId'])
          || hasValidPaymentContributionItemId(request.resource.data.contributionItemId))
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 1
        && request.resource.data.amountCents <= 1000000
        && request.resource.data.currency == 'EUR'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 160
        && hasValidPaymentAccountingCategory(request.resource.data.accountingCategory)
        && request.resource.data.isOptional is bool
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() <= 10
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName is string
        && request.resource.data.collectorName.size() > 0
        && request.resource.data.collectorName.size() <= 100
        && hasValidPaymentInstallmentFields();
    }

    function isValidPaymentRequestCreate(boatId) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return hasValidPaymentRequestCore(boatId, false)
        && request.resource.data.collectorName == profile.collectorName
        && hasValidPaymentMethodSelection(request.resource.data.paymentMethods)
        && paymentMethodsAllowedByProfile(boatId, request.resource.data.paymentMethods)
        // Una richiesta ordinaria non può fingersi un incasso già registrato
        // né attribuirsi una data di ricezione storica.
        && (!request.resource.data.keys().hasAll(['entryType'])
          || request.resource.data.entryType == 'request')
        && !request.resource.data.keys().hasAll(['receivedOn'])
        && request.resource.data.status == 'prepared'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verifiedAt == null
        && request.resource.data.verifiedBy == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.cancelledBy == null;
    }

    // La nota è rivolta alla persona nel messaggio WhatsApp, ma non deve
    // comparire nel documento di pagamento letto dall'equipaggio. Viene
    // quindi creata una sola volta, nello stesso batch della richiesta, in un
    // figlio leggibile soltanto dallo skipper.
    function hasValidPrivatePaymentMessageCreate(boatId, requestId) {
      let paymentRef = /databases/$(database)/documents/boats/$(boatId)/paymentRequests/$(requestId);
      return request.resource.data.keys().hasAll(['messageDetails', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['messageDetails', 'createdAt', 'createdBy'])
        && request.resource.data.messageDetails is string
        && request.resource.data.messageDetails.size() > 0
        && request.resource.data.messageDetails.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        // Una nota non può essere aggiunta né riscritta dopo la preparazione
        // della richiesta: il batch deve creare entrambe le risorse.
        && !exists(paymentRef)
        && existsAfter(paymentRef)
        && getAfter(paymentRef).data.createdBy == request.auth.uid
        && getAfter(paymentRef).data.status == 'prepared'
        && getAfter(paymentRef).data.entryType == 'request';
    }

    // Un acconto già ricevuto non è una "richiesta" inviata retroattivamente:
    // viene registrato dal solo skipper associato alla barca come incasso verificato. Può
    // nascere dalla proiezione prima dell'invito, ma senza canali, link,
    // coordinate o note da mostrare al futuro partecipante.
    function isValidManualReceiptCreate(boatId) {
      return hasValidPaymentRequestCore(boatId, true)
        && request.resource.data.keys().hasAll(['contributionItemId', 'entryType', 'installmentType', 'allocation', 'receivedOn'])
        && request.resource.data.contributionItemId in ['berth_base', 'berth_double_cabin', 'berth_single_cabin', 'berth_dinette', 'berth_other', 'protection_insurance']
        && request.resource.data.entryType == 'manual_receipt'
        && request.resource.data.installmentType == 'advance'
        && request.resource.data.accountingCategory == 'cost_recovery'
        && request.resource.data.isOptional == false
        && request.resource.data.dueDate == ''
        && request.resource.data.reason == 'Acconto registrato'
        && hasValidEmptyPaymentMethodSelection(request.resource.data.paymentMethods)
        && request.resource.data.status == 'verified'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.cancelledAt == null
        && request.resource.data.cancelledBy == null;
    }

    function canVerifyPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'verifiedBy']);
    }

    function canCancelPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);
    }

    // Non riscrive mai importo, destinatario o stato: serve solo a classificare
    // una richiesta storica già verificata senza doverne creare un duplicato.
    // Non la trasforma in "ricevuta manuale", perché quest'ultima richiede la
    // data storica obbligatoria e può nascere dalla proiezione prima dell'invito.
    function canClassifyVerifiedLegacyPaymentInstallment() {
      return resource.data.status == 'verified'
        && !resource.data.keys().hasAny(['entryType', 'installmentType', 'allocation', 'receivedOn'])
        && request.resource.data.keys().hasAll(['entryType', 'installmentType'])
        && request.resource.data.entryType == 'request'
        && hasValidPaymentInstallmentFields()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['entryType', 'installmentType', 'allocation']);
    }

    // Questa lettura è separata dalla normale area skipper per evitare che un
    // partecipante debba attraversare più catene di `get` annidate. Restano
    // obbligatori: account password della persona, crewAccess corrente,
    // invito attivo associato allo stesso ID della richiesta e briefing
    // accettato nella sua versione pubblicata corrente.
    function canReadOwnPaymentRequest(boatId) {
      let access = get(/databases/$(database)/documents/crewAccess/$(request.auth.uid));
      let inviteId = access.data.inviteId;
      let invite = get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId));
      let board = get(/databases/$(database)/documents/boats/$(boatId)/briefing/board);
      let acceptance = get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId));
      return isPasswordCrew()
        && exists(/databases/$(database)/documents/crewAccess/$(request.auth.uid))
        && access.data.userId == request.auth.uid
        && access.data.loginEmail == request.auth.token.email
        && access.data.boatId == boatId
        && access.data.inviteId is string
        && resource.data.recipientId is string
        && resource.data.recipientId == inviteId
        && exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId))
        && invite.data.status == 'active'
        && invite.data.participantUid == request.auth.uid
        && exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && board.data.rulesText is string
        && board.data.rulesText.size() > 0
        && board.data.rulesVersion is int
        && exists(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId))
        && acceptance.data.inviteId == inviteId
        && acceptance.data.acceptedBy == request.auth.uid
        && acceptance.data.rulesVersion == board.data.rulesVersion
        && (!board.data.keys().hasAll(['fullRulesRequired'])
          || board.data.fullRulesRequired != true
          || (acceptance.data.keys().hasAll(['fullRulesRead'])
            && acceptance.data.fullRulesRead == true));
    }

    // La vetrina pubblica non riusa mai /boats: quel documento contiene
    // identificativi tecnici e metadati privati. Una mappa privata e
    // immutabile lega l'ID casuale al solo skipper che l'ha creato.
    function isPublicFleetOwner(publicId) {
      return isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && existsAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId))
        && getAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId)).data.skipperId == request.auth.uid;
    }

    function matchesPrivateFleetBoat(publicId) {
      return existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId
        && request.resource.data.name == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.name
        && request.resource.data.model == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.model
        && request.resource.data.boatType == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.boatType
        && request.resource.data.skipperName == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperName
        && request.resource.data.capacity == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.capacity;
    }

    function hasValidPublicFleetProfile() {
      return request.resource.data.keys().hasAll(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 100
        && request.resource.data.boatType in ['Catamarano', 'Monoscafo', 'Gommone', 'Altro']
        && request.resource.data.skipperName is string
        && request.resource.data.skipperName.size() > 0
        && request.resource.data.skipperName.size() <= 100
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 30
        && request.resource.data.showAvailability is bool
        && request.resource.data.berthPreference in ['not_specified', 'cabin_female', 'cabin_male', 'cabin_mixed', 'dinette', 'other']
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.showAvailability == true
          && request.resource.data.availableSeats is int
          && request.resource.data.availableSeats >= 0
          && request.resource.data.availableSeats <= request.resource.data.capacity)
          || (request.resource.data.showAvailability == false
            && request.resource.data.availableSeats == null
            && request.resource.data.berthPreference == 'not_specified'));
    }

    match /events/egadi-2026 {
      // Anche il documento evento resta non leggibile dall'area privata chiusa.
      allow read: if isPrivateAreaOpen() && isOrganizer();
      allow write: if isOrganizer();
    }

    match /events/egadi-2026/publicFleet/{publicId} {
      // Dati dichiarati dallo skipper per la sola vetrina: nessun contatto,
      // UID, ID barca, invito, Crew List o pagamento è presente qui.
      allow get, list: if isPublicFleetEnabled();
      allow create, update: if isPrivateAreaOpen()
        && isPublicFleetOwner(publicId)
        && matchesPrivateFleetBoat(publicId)
        && hasValidPublicFleetProfile();
      allow delete: if isPrivateAreaOpen() && (isOrganizer() || isPublicFleetOwner(publicId));
    }

    match /events/egadi-2026/publicFleetOwners/{publicId} {
      // È un legame tecnico non leggibile dal web: non contiene alcun dato
      // Crew List e, dopo la creazione, può solo essere riscritto identico.
      allow create: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasAll(['skipperId'])
        && request.resource.data.keys().hasOnly(['skipperId'])
        && request.resource.data.skipperId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId;
      allow update: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && resource.data.skipperId == request.auth.uid
        && request.resource.data == resource.data;
      allow read, delete: if false;
    }

    // Indice pseudonimo: non contiene nome, telefono o Crew List. È creato
    // solo dopo l'attivazione e serve a risalire all'account dal numero inserito.
    match /crewLoginIndex/{phoneFingerprint} {
      allow get: if isPrivateAreaOpen();
      allow list: if false;
      allow create: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint);
      allow update: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint)
        && resource.data.boatId == request.resource.data.boatId
        && resource.data.inviteId == request.resource.data.inviteId;
      allow delete: if false;
    }

    match /crewAccess/{userId} {
      allow get: if isPrivateAreaOpen() && isCurrentCrewAccess(userId);
      allow list: if false;
      allow create, update: if isPrivateAreaOpen() && isValidCrewAccess(userId);
      allow delete: if false;
    }

    match /boats/{boatId} {
      // La pagina skipper legge esclusivamente /boats/{proprio UID}. Se il
      // documento non esiste, la lettura puntuale serve solo a mostrare la
      // registrazione; se esiste, resta leggibile allo skipper associato.
      allow get: if isPrivateAreaOpen() && (isOrganizer()
        || (isGoogleSkipperAccount() && boatId == request.auth.uid
          && (!exists(/databases/$(database)/documents/boats/$(boatId))
            || get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid)));
      allow list: if false;
      allow create: if isPrivateAreaOpen() && isGoogleSkipperAccount() && boatId == request.auth.uid && request.resource.data.skipperId == request.auth.uid && hasValidPrivateBoatCapacity();
      // Nemmeno l'organizzatore può riassociare temporaneamente uno skipper
      // cambiando skipperId: quel legame protegge anche il dossier privato.
      // Un'eventuale riassegnazione dello skipper segue una procedura
      // amministrativa separata, non eseguibile dal client.
      allow update: if isPrivateAreaOpen()
        && request.resource.data.skipperId == resource.data.skipperId
        && request.resource.data.eventId == resource.data.eventId
        && (isOrganizer() || (isSkipper(boatId)
        // L'ID della vetrina può essere aggiunto alla barca legacy una sola
        // volta, poi resta immutabile per non sostituire una card esistente.
        && (!resource.data.keys().hasAll(['publicFleetId'])
          || request.resource.data.publicFleetId == resource.data.publicFleetId)
        && hasValidPrivateBoatCapacity()));
      allow delete: if isPrivateAreaOpen() && isOrganizer();

      match /invites/{inviteId} {
        // Il link è un codice di attivazione, non l'accesso quotidiano.
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId)) && isValidNewInvite(boatId, inviteId);
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow update: if isPrivateAreaOpen() && (canClaimInvite(boatId, inviteId)
          || ((isOrganizer() || isSkipper(boatId)) && canReissueInvite(boatId, inviteId)));
      }

      // Posto e preventivo restano privati finché lo skipper non invia il
      // link personale. L'equipaggio attivo può leggere soltanto il proprio
      // documento puntuale: mai la lista, mai le proiezioni altrui.
      match /crewProjections/{projectionId} {
        allow get: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, projectionId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create: if isPrivateAreaOpen()
          && (((isOrganizer() || isSkipper(boatId)) && isValidCrewProjectionCreate(boatId, projectionId))
            || (isSkipper(boatId) && isValidCrewProjectionLegacyInviteCreate(boatId, projectionId)));
        allow update: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionDraftUpdate(boatId, projectionId);
        allow update: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionInvitedUpdate(boatId, projectionId);
        allow update: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionInviteTransition(boatId, projectionId);
        // Si libera solo una bozza senza accesso. Dopo l'invito il record
        // resta la traccia privata che collega lo stesso posto alla Crew List.
        allow delete: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && resource.data.status == 'projected'
          && resource.data.inviteId == null
          && resource.data.invitedAt == null;
      }

      match /members/{memberId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId));
        allow create: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberCreate())
          || isValidCrewMemberCreate(boatId, memberId));
        allow update: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberUpdate())
          || isValidCrewMemberUpdate(boatId, memberId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      // Bozza personale dell'equipaggio: non e' una voce Crew List e non e'
      // leggibile da skipper, organizzatore o altri partecipanti. Per
      // riprenderla e' richiesta l'accettazione del briefing corrente.
      match /crewDrafts/{inviteId} {
        allow get: if isPrivateAreaOpen()
          && isInviteHolder(boatId, inviteId)
          && hasCurrentBriefingAcceptance(boatId, inviteId)
          && (!exists(/databases/$(database)/documents/boats/$(boatId)/crewDrafts/$(inviteId))
            || hasCurrentCrewDraftAudience(boatId, inviteId, resource.data));
        allow list: if false;
        allow create: if isPrivateAreaOpen()
          && isInviteHolder(boatId, inviteId)
          && hasCurrentBriefingAcceptance(boatId, inviteId)
          && hasValidCrewDraftPayload()
          && hasCurrentCrewDraftAudience(boatId, inviteId, request.resource.data);
        allow update: if isPrivateAreaOpen()
          && isInviteHolder(boatId, inviteId)
          && hasCurrentBriefingAcceptance(boatId, inviteId)
          && hasValidCrewDraftPayload()
          && hasCurrentCrewDraftAudience(boatId, inviteId, resource.data)
          && hasCurrentCrewDraftAudience(boatId, inviteId, request.resource.data);
        allow delete: if isPrivateAreaOpen()
          && ((isInviteHolder(boatId, inviteId)
              && hasCurrentBriefingAcceptance(boatId, inviteId)
              && hasCurrentCrewDraftAudience(boatId, inviteId, resource.data))
            || isCrewDraftCleanupDuringInviteReissue(boatId, inviteId));
      }

      // Riferimenti personali e abilitazioni dello skipper: un documento
      // singolo privato, non consultabile da equipaggio, flotta o
      // organizzatore. Le copie non vengono mai caricate in Firestore.
      match /skipperProfile/{profileId} {
        allow get: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen()
          && profileId == 'default'
          && isSkipper(boatId)
          && hasValidSkipperProfilePayload();
        allow delete: if false;
      }

      // La bozza non sostituisce il dossier finale e non e' usata dal PDF.
      // Solo lo skipper associato alla barca puo' riprendere o cancellare il
      // proprio lavoro parziale.
      match /skipperProfileDraft/{profileId} {
        allow get: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen()
          && profileId == 'default'
          && isSkipper(boatId)
          && hasValidSkipperProfileDraftPayload();
        allow delete: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId);
      }

      // Due tratte private dello skipper: andata e ritorno. Sono bozze
      // salvabili anche incomplete; non sono una lista transfer e non danno
      // alcun accesso diretto alla società che lo gestirà.
      match /skipperTravel/{legId} {
        allow get: if isPrivateAreaOpen()
          && (legId == 'outbound' || legId == 'return')
          && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen()
          && isSkipper(boatId)
          && hasValidSkipperTravelPayload(legId);
        allow delete: if false;
      }

      // Percorso legacy: il nuovo accesso usa soltanto /crewAccess/{uid}.
      match /participantAccess/{userId} {
        allow read, write: if false;
      }

      // Il profilo è privato allo skipper e conserva istruzioni di incasso
      // non segrete. Non contiene password, OTP, carte o credenziali provider.
      match /collectionProfile/{profileId} {
        allow get: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId) && hasValidCollectionProfile();
        allow delete: if false;
      }

      // Riepilogo leggibile dall'equipaggio già confermato. È separato dal
      // profilo di incasso privato e contiene solo dieci voci standardizzate,
      // stato e importo eventuale: mai link, IBAN o istruzioni di pagamento.
      match /contributionPlan/{planId} {
        allow get: if isPrivateAreaOpen()
          && planId == 'default'
          && (isOrganizer()
            || isSkipper(boatId)
            || hasCurrentParticipantBriefingAcceptance(boatId));
        allow list: if false;
        allow create: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && hasValidContributionPlanV3OrV4();
        allow update: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && (isContributionPlanV4(request.resource.data)
            ? hasValidContributionPlanV4()
            : (!isContributionPlanV4(resource.data)
              && (isContributionPlanV3(request.resource.data)
                ? hasValidContributionPlanV3()
                : (!isContributionPlanV3(resource.data)
                  && (isContributionPlanV2(request.resource.data)
                    ? hasValidContributionPlanV2()
                    : (!isContributionPlanV2(resource.data)
                      && hasValidContributionPlanV1()))))));
        allow delete: if false;
      }

      // Il prospetto interno della cassa skipper non è una comunicazione
      // all'equipaggio: anche l'organizzatore non lo legge o modifica. Lo
      // skipper può soltanto usare il documento standard /default.
      match /costPlan/{planId} {
        allow get: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId);
        allow list: if false;
        allow create: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && hasValidSkipperCostPlanV6OrV7();
        // V7 è il formato canonico. La compatibilità V6 è soltanto una
        // passerella di rilascio: resta disponibile finché il piano è V6,
        // poi il primo salvataggio V7 blocca per sempre il downgrade cache.
        allow update: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && (isSkipperCostPlanV7(request.resource.data)
            ? hasValidSkipperCostPlanV7()
            : (!isSkipperCostPlanV7(resource.data)
              && hasValidSkipperCostPlanV6()));
        allow delete: if false;
      }

      match /paymentRequests/{requestId} {
        // Le richieste e la loro categoria contabile alimentano soltanto la
        // contabilità privata dello skipper: l'organizzatore non le legge né
        // può alterare il pareggio della Cassa skipper.
        allow read: if isPrivateAreaOpen()
          && (isSkipper(boatId)
            || canReadOwnPaymentRequest(boatId));
        // Il profilo di incasso protegge le sole richieste da inviare. Una
        // ricevuta manuale non propone canali di pagamento e può documentare
        // un acconto già raccolto prima della configurazione del profilo.
        allow create: if isPrivateAreaOpen()
          && isSkipper(boatId)
          // La diramazione evita di valutare anche il profilo e tutti i suoi
          // link quando il payload è una ricevuta manuale già verificata.
          && ((request.resource.data.keys().hasAll(['entryType'])
              && request.resource.data.entryType == 'manual_receipt')
            ? isValidManualReceiptCreate(boatId)
            : (collectionProfileExists(boatId)
              && isValidPaymentRequestCreate(boatId)));
        allow update: if isPrivateAreaOpen()
          && isSkipper(boatId)
          && (canVerifyPayment()
            || canCancelPayment()
            || canClassifyVerifiedLegacyPaymentInstallment());
        allow delete: if false;

        match /private/{detailId} {
          // Le note del messaggio non sono una comunicazione dentro l'area
          // equipaggio. Non si elencano e possono essere lette solo dallo
          // skipper della stessa barca.
          allow get: if isPrivateAreaOpen()
            && detailId == 'message'
            && isSkipper(boatId);
          allow list: if false;
          allow create: if isPrivateAreaOpen()
            && detailId == 'message'
            && isSkipper(boatId)
            && hasValidPrivatePaymentMessageCreate(boatId, requestId);
          allow update, delete: if false;
        }
      }

      match /briefing/{briefingId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId));
        allow create: if isPrivateAreaOpen() && briefingId == 'board' && (isOrganizer() || isSkipper(boatId)) && isValidBoardBriefingCreate();
        allow update: if isPrivateAreaOpen() && briefingId == 'board' && (isOrganizer() || isSkipper(boatId)) && isValidBoardBriefingUpdate();
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId) || hasCurrentParticipantBriefingAcceptance(boatId));
        allow create, update, delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      match /ruleAcceptances/{inviteId} {
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create, update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));

        match /history/{versionId} {
          allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
          allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
          allow update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        }
      }
    }
  }
}
