rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordCrew() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string;
    }

    function isGoogleSkipperAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOrganizer() {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/egadi-2026).data.organizerIds;
    }

    // L'area privata resta negata di default. Il titolare la apre soltanto
    // dopo informativa definitiva, test Rules e test browser separati.
    function isPrivateAreaOpen() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.privateAreaEnabled == true;
    }

    // Interruttore indipendente: la vetrina pubblica può essere spenta senza
    // toccare gli accessi privati di skipper ed equipaggi.
    function isPublicFleetEnabled() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.publicFleetEnabled == true;
    }

    function isSkipper(boatId) {
      return isGoogleSkipperAccount()
        && exists(/databases/$(database)/documents/boats/$(boatId))
        && get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid;
    }

    function isInviteHolder(boatId, inviteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.status == 'active'
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.participantUid == request.auth.uid;
    }

    function hasValidMemberPayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.birthDate is string
        && request.resource.data.birthPlace is string
        && request.resource.data.nationality is string
        && request.resource.data.gender is string
        && request.resource.data.documentType is string
        && request.resource.data.documentNumber is string
        && request.resource.data.documentExpiry is string
        && request.resource.data.role is string
        && (!request.resource.data.keys().hasAll(['roleConfirmed']) || request.resource.data.roleConfirmed is bool)
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.charterConsent is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOwnerMemberCreate() {
      return hasValidMemberPayload()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidOwnerMemberUpdate() {
      return hasValidMemberPayload()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt']);
    }

    function isValidCrewMemberCreate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasCurrentBriefingAcceptance(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.keys().hasAll(['roleConfirmed'])
        && request.resource.data.roleConfirmed == false
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasSafeCrewRoleConfirmation() {
      return (request.resource.data.role == resource.data.role
          && ((!resource.data.keys().hasAll(['roleConfirmed']) && !request.resource.data.keys().hasAll(['roleConfirmed']))
            || (resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == resource.data.roleConfirmed)
            || (!resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == false)))
        || (request.resource.data.role != resource.data.role
          && request.resource.data.keys().hasAll(['roleConfirmed'])
          && request.resource.data.roleConfirmed == false);
    }

    function isValidCrewMemberUpdate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasCurrentBriefingAcceptance(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && hasSafeCrewRoleConfirmation();
    }

    function isValidNewInvite(boatId, inviteId) {
      return request.resource.data.keys().hasAll(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'preferredLocale', 'createdAt', 'createdBy'])
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.participantUid == null
        && request.resource.data.status == 'pending'
        && request.resource.data.accessVersion == 1
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        // Facoltativo soltanto per compatibilita con gli inviti creati prima
        // del selettore lingua; i nuovi client inviano sempre it oppure en.
        && (!request.resource.data.keys().hasAll(['preferredLocale'])
          || request.resource.data.preferredLocale in ['it', 'en'])
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    // La proiezione è il posto riservato dal solo skipper prima che esista un
    // invito. Non è una Crew List, non è pubblica e non contiene istruzioni
    // di pagamento: gli importi servono esclusivamente al preventivo privato.
    function hasValidCrewProjectionPayload(projectionId) {
      return request.resource.data.keys().hasAll(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['id', 'firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'status', 'inviteId', 'invitedAt', 'createdAt', 'createdBy', 'updatedAt', 'updatedBy'])
        && projectionId.matches('^[a-f0-9]{48}$')
        && request.resource.data.id == projectionId
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 80
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 80
        && request.resource.data.displayName is string
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.whatsappNumber is string
        && request.resource.data.whatsappNumber.size() >= 8
        && request.resource.data.whatsappNumber.size() <= 30
        && request.resource.data.plannedRole is string
        && request.resource.data.plannedRole.size() > 0
        && request.resource.data.plannedRole.size() <= 100
        && request.resource.data.berthType in ['to_define', 'double_cabin', 'single_cabin', 'dinette', 'other']
        && request.resource.data.berthCents is int
        && request.resource.data.berthCents >= 0
        && request.resource.data.berthCents <= 1000000
        && request.resource.data.starterPackCents is int
        && request.resource.data.starterPackCents >= 0
        && request.resource.data.starterPackCents <= 1000000
        && request.resource.data.protectionInsuranceCents is int
        && request.resource.data.protectionInsuranceCents >= 0
        && request.resource.data.protectionInsuranceCents <= 1000000
        && request.resource.data.refundableDepositCents is int
        && request.resource.data.refundableDepositCents >= 0
        && request.resource.data.refundableDepositCents <= 1000000
        && request.resource.data.preferredLocale in ['it', 'en']
        && request.resource.data.contactConsent == true
        && request.resource.data.createdAt is timestamp
        && request.resource.data.createdBy is string
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function isValidCrewProjectionCreate(projectionId) {
      return hasValidCrewProjectionPayload(projectionId)
        && request.resource.data.status == 'projected'
        && request.resource.data.inviteId == null
        && request.resource.data.invitedAt == null
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidCrewProjectionDraftUpdate(projectionId) {
      return hasValidCrewProjectionPayload(projectionId)
        && resource.data.status == 'projected'
        && resource.data.inviteId == null
        && resource.data.invitedAt == null
        && request.resource.data.status == 'projected'
        && request.resource.data.inviteId == null
        && request.resource.data.invitedAt == null
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'displayName', 'whatsappNumber', 'plannedRole', 'berthType', 'berthCents', 'starterPackCents', 'protectionInsuranceCents', 'refundableDepositCents', 'preferredLocale', 'contactConsent', 'updatedAt', 'updatedBy']);
    }

    // Il collegamento diventa reale solo nel batch che crea l'invito con lo
    // stesso ID. `!exists` impedisce di agganciare una proiezione a un invito
    // già esistente o a un record appartenente a un altro flusso.
    function hasMatchingCrewProjectionInviteAfter(boatId, projectionId) {
      return !exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && existsAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId))
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.id == projectionId
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.boatId == boatId
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.status == 'pending'
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.displayName == request.resource.data.displayName
        && getAfter(/databases/$(database)/documents/boats/$(boatId)/invites/$(projectionId)).data.whatsappNumber == request.resource.data.whatsappNumber;
    }

    function isValidCrewProjectionInviteTransition(boatId, projectionId) {
      return resource.data.id == projectionId
        && resource.data.status == 'projected'
        && resource.data.inviteId == null
        && resource.data.invitedAt == null
        && request.resource.data.status == 'invited'
        && request.resource.data.inviteId == projectionId
        && request.resource.data.invitedAt == request.time
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'inviteId', 'invitedAt', 'updatedAt', 'updatedBy'])
        && hasMatchingCrewProjectionInviteAfter(boatId, projectionId);
    }

    function canClaimInvite(boatId, inviteId) {
      return isPasswordCrew()
        && resource.data.id == inviteId
        && resource.data.boatId == boatId
        && resource.data.status == 'pending'
        && resource.data.participantUid == null
        && resource.data.expiresAt > request.time
        && resource.data.loginEmail == request.auth.token.email
        && request.resource.data.participantUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUid', 'status', 'activatedAt']);
    }

    function canReissueInvite(boatId, inviteId) {
      return resource.data.id == inviteId
        && resource.data.boatId == boatId
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.status == 'pending'
        && request.resource.data.participantUid == null
        && request.resource.data.accessVersion is int
        && ((resource.data.keys().hasAll(['accessVersion'])
          && resource.data.accessVersion is int
          && request.resource.data.accessVersion == resource.data.accessVersion + 1)
          || (!resource.data.keys().hasAll(['accessVersion'])
            && request.resource.data.accessVersion == 1))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && (!request.resource.data.keys().hasAll(['preferredLocale'])
          || request.resource.data.preferredLocale in ['it', 'en'])
        && request.resource.data.reissuedAt == request.time
        && request.resource.data.reissuedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'preferredLocale', 'activatedAt', 'reissuedAt', 'reissuedBy']);
    }

    function isCurrentCrewAccess(userId) {
      return signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && resource.data.loginEmail == request.auth.token.email
        && resource.data.boatId is string
        && resource.data.inviteId is string
        && isInviteHolder(resource.data.boatId, resource.data.inviteId);
    }

    function isValidCrewAccess(userId) {
      return isPasswordCrew()
        && userId == request.auth.uid
        && request.resource.data.keys().hasAll(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId is string
        && request.resource.data.inviteId is string
        && request.resource.data.updatedAt == request.time
        && isInviteHolder(request.resource.data.boatId, request.resource.data.inviteId);
    }

    function isBoatParticipant(boatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/crewAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.boatId == boatId
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.userId == request.auth.uid
        && isInviteHolder(boatId, get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.inviteId);
    }

    function canWriteCrewLoginIndex(phoneFingerprint) {
      let access = get(/databases/$(database)/documents/crewAccess/$(request.auth.uid));
      let invite = get(/databases/$(database)/documents/boats/$(access.data.boatId)/invites/$(access.data.inviteId));
      return isPasswordCrew()
        && access.data.userId == request.auth.uid
        && access.data.loginEmail == request.auth.token.email
        && invite.data.status == 'active'
        && invite.data.participantUid == request.auth.uid
        && invite.data.phoneFingerprint == phoneFingerprint
        && request.resource.data.keys().hasAll(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId == access.data.boatId
        && request.resource.data.inviteId == access.data.inviteId
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRuleAcceptance(boatId, inviteId) {
      return isInviteHolder(boatId, inviteId)
        && hasPublishedBriefing(boatId)
        && request.resource.data.keys().hasOnly(['inviteId', 'acceptedBy', 'rulesVersion', 'fullRulesRead', 'acceptedLocale', 'acceptedAt'])
        && request.resource.data.inviteId == inviteId
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.rulesVersion is int
        && (!request.resource.data.keys().hasAll(['fullRulesRead']) || request.resource.data.fullRulesRead == true)
        && (!request.resource.data.keys().hasAll(['acceptedLocale'])
          || request.resource.data.acceptedLocale == 'it'
          || (request.resource.data.acceptedLocale == 'en' && hasOfficialEnglishBriefing(boatId)))
        && (!briefingRequiresFullRulesRead(boatId)
          || (request.resource.data.keys().hasAll(['fullRulesRead']) && request.resource.data.fullRulesRead == true))
        && request.resource.data.acceptedAt == request.time
        && request.resource.data.rulesVersion == get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion;
    }

    // Un invito attivo non basta per comparire nella Crew List: prima va
    // accettata l'ultima versione del briefing pubblicato dallo skipper.
    function hasPublishedBriefing(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesText is string
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesText.size() > 0
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion is int;
    }

    // La versione inglese è un contenuto ufficiale parallelo, non una
    // traduzione automatica. È richiesta solo per un'accettazione in inglese.
    function hasOfficialEnglishBriefing(boatId) {
      let board = get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data;
      return board.keys().hasAll(['rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'scheduleNoteEn'])
        && board.rulesTitleEn is string
        && board.rulesTitleEn.size() > 0
        && board.rulesSummaryEn is string
        && board.rulesSummaryEn.size() > 0
        && board.rulesTextEn is string
        && board.rulesTextEn.size() > 0
        && board.scheduleNoteEn is string;
    }

    // Lo skipper resta proprietario del contenuto, ma non può modificare il
    // briefing già accettato senza produrre una nuova versione. I documenti
    // legacy sono ammessi soltanto in lettura: il primo salvataggio li porta
    // nel formato completo e rende obbligatoria la rilettura.
    function hasValidBoardBriefingPayload() {
      return request.resource.data.keys().hasAll(['rulesTitle', 'rulesSummary', 'rulesText', 'fullRulesRequired', 'rulesVersion', 'meetingPoint', 'boardingAt', 'departureAt', 'returnAt', 'scheduleNote', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['rulesTitle', 'rulesSummary', 'rulesText', 'rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'fullRulesRequired', 'rulesVersion', 'meetingPoint', 'boardingAt', 'departureAt', 'returnAt', 'scheduleNote', 'scheduleNoteEn', 'updatedAt', 'updatedBy'])
        && request.resource.data.rulesTitle is string
        && request.resource.data.rulesTitle.size() > 0
        && request.resource.data.rulesTitle.size() <= 120
        && request.resource.data.rulesSummary is string
        && request.resource.data.rulesSummary.size() > 0
        && request.resource.data.rulesSummary.size() <= 1800
        && request.resource.data.rulesText is string
        && request.resource.data.rulesText.size() > 0
        && request.resource.data.rulesText.size() <= 9000
        && request.resource.data.fullRulesRequired == true
        && request.resource.data.rulesVersion is int
        && request.resource.data.rulesVersion > 0
        && request.resource.data.meetingPoint is string
        && request.resource.data.meetingPoint.size() <= 160
        && request.resource.data.boardingAt is string
        && request.resource.data.boardingAt.size() <= 40
        && request.resource.data.departureAt is string
        && request.resource.data.departureAt.size() <= 40
        && request.resource.data.returnAt is string
        && request.resource.data.returnAt.size() <= 40
        && request.resource.data.scheduleNote is string
        && request.resource.data.scheduleNote.size() <= 400
        && (!request.resource.data.keys().hasAll(['rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'scheduleNoteEn'])
          || (request.resource.data.rulesTitleEn is string
            && request.resource.data.rulesTitleEn.size() <= 120
            && request.resource.data.rulesSummaryEn is string
            && request.resource.data.rulesSummaryEn.size() <= 1800
            && request.resource.data.rulesTextEn is string
            && request.resource.data.rulesTextEn.size() <= 9000
            && request.resource.data.scheduleNoteEn is string
            && request.resource.data.scheduleNoteEn.size() <= 400
            && ((request.resource.data.rulesTitleEn.size() == 0
                && request.resource.data.rulesSummaryEn.size() == 0
                && request.resource.data.rulesTextEn.size() == 0
                && request.resource.data.scheduleNoteEn.size() == 0)
              || (request.resource.data.rulesTitleEn.size() > 0
                && request.resource.data.rulesSummaryEn.size() > 0
                && request.resource.data.rulesTextEn.size() > 0))))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function boardContentHasChanged() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(['rulesTitle', 'rulesSummary', 'rulesText', 'rulesTitleEn', 'rulesSummaryEn', 'rulesTextEn', 'fullRulesRequired', 'meetingPoint', 'boardingAt', 'departureAt', 'returnAt', 'scheduleNote', 'scheduleNoteEn']);
    }

    function hasValidBoardVersionUpdate() {
      return (resource.data.keys().hasAll(['rulesVersion'])
          && resource.data.rulesVersion is int
          && ((boardContentHasChanged() && request.resource.data.rulesVersion == resource.data.rulesVersion + 1)
            || (!boardContentHasChanged() && request.resource.data.rulesVersion == resource.data.rulesVersion)))
        || (!resource.data.keys().hasAll(['rulesVersion']) && request.resource.data.rulesVersion == 1);
    }

    function isValidBoardBriefingCreate() {
      return hasValidBoardBriefingPayload()
        && request.resource.data.rulesVersion == 1;
    }

    function isValidBoardBriefingUpdate() {
      return hasValidBoardBriefingPayload()
        && hasValidBoardVersionUpdate();
    }

    function briefingRequiresFullRulesRead(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.keys().hasAll(['fullRulesRequired'])
        && get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.fullRulesRequired == true;
    }

    function hasCurrentBriefingAcceptance(boatId, inviteId) {
      return hasPublishedBriefing(boatId)
        && exists(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.inviteId == inviteId
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.acceptedBy == request.auth.uid
        && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.rulesVersion == get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion
        && (!briefingRequiresFullRulesRead(boatId)
          || (get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.keys().hasAll(['fullRulesRead'])
            && get(/databases/$(database)/documents/boats/$(boatId)/ruleAcceptances/$(inviteId)).data.fullRulesRead == true));
    }

    function hasValidPaymentMethodSelection(methods) {
      return methods is map
        && methods.keys().hasOnly(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && methods.keys().hasAny(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && (!methods.keys().hasAll(['paypal']) || methods.paypal == true)
        && (!methods.keys().hasAll(['satispay']) || methods.satispay == true)
        && (!methods.keys().hasAll(['revolut']) || methods.revolut == true)
        && (!methods.keys().hasAll(['bankTransfer']) || methods.bankTransfer == true);
    }

    function isHttpsPaymentLink(value) {
      return value is string
        && value.size() >= 9
        && value.size() <= 500
        && value.matches('^https://.+$');
    }

    function isValidRevolutDestination(value) {
      return isHttpsPaymentLink(value)
        || (value is string && value.matches('^@[A-Za-z0-9._-]{3,50}$'));
    }

    function hasValidBankTransferDetails(details) {
      return details is map
        && details.keys().hasAll(['iban', 'accountHolder'])
        && details.keys().hasOnly(['iban', 'accountHolder'])
        && details.iban is string
        && details.accountHolder is string
        && ((details.iban == '' && details.accountHolder == '')
          || (details.iban.matches('^[A-Z]{2}[0-9]{2}[A-Z0-9]{11,30}$')
            && details.accountHolder.size() >= 2
            && details.accountHolder.size() <= 100));
    }

    function hasValidPaymentDetails(details) {
      return details is map
        && details.keys().hasAll(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && details.keys().hasOnly(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && details.paypal is string
        && details.satispay is string
        && details.revolut is string
        && (details.paypal == '' || isHttpsPaymentLink(details.paypal))
        && (details.satispay == '' || isHttpsPaymentLink(details.satispay))
        && (details.revolut == '' || isValidRevolutDestination(details.revolut))
        && hasValidBankTransferDetails(details.bankTransfer);
    }

    function hasValidPrivateBoatCapacity() {
      return !request.resource.data.keys().hasAll(['totalBerths'])
        || (request.resource.data.totalBerths is int
          && request.resource.data.totalBerths >= 2
          && request.resource.data.totalBerths <= 31
          && request.resource.data.capacity is int
          && request.resource.data.capacity >= 1
          && request.resource.data.capacity <= 30
          && request.resource.data.capacity == request.resource.data.totalBerths - 1);
    }

    // Il piano quote è volutamente un elenco chiuso: non contiene contatti,
    // coordinate di pagamento, link o testo libero che possa finire nell'area
    // equipaggio. Gli importi sono sempre in centesimi per persona.
    function hasValidContributionItem(item) {
      return item is map
        && item.keys().hasAll(['state', 'amountCents'])
        && item.keys().hasOnly(['state', 'amountCents'])
        && item.state is string
        && item.state in ['to_define', 'included', 'extra', 'local', 'not_applicable']
        && item.amountCents is int
        && item.amountCents >= 0
        && item.amountCents <= 1000000
        // Solo una voce extra o da regolare in loco può avere un importo.
        && (item.state in ['extra', 'local'] || item.amountCents == 0);
    }

    function hasValidContributionPlan() {
      let items = request.resource.data.items;
      return request.resource.data.keys().hasAll(['items', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['items', 'updatedAt', 'updatedBy'])
        && items is map
        && items.keys().hasAll(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'refundable_deposit'])
        && items.keys().hasOnly(['berth', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'refundable_deposit'])
        && hasValidContributionItem(items.berth)
        && hasValidContributionItem(items.starter_pack)
        && hasValidContributionItem(items.linen_towels)
        && hasValidContributionItem(items.protection_insurance)
        && hasValidContributionItem(items.provisions)
        && hasValidContributionItem(items.fuel)
        && hasValidContributionItem(items.transfer)
        && hasValidContributionItem(items.refundable_deposit)
        // Una cauzione rimborsabile non è mai parte silenziosa della quota,
        // né una richiesta a distanza: si porta e si regola in loco.
        && items.refundable_deposit.state in ['to_define', 'local', 'not_applicable']
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // La cassa skipper è un prospetto privato di soli importi aggregati.
    // Non può contenere nominativi, quote individuali, note, istruzioni di
    // pagamento o una categoria per cene: non è un listino né un incasso.
    function hasValidSkipperCostPlan() {
      return request.resource.data.keys().hasAll(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'payingParticipants', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['charterCents', 'skipperFlightTrainCents', 'skipperCarCents', 'skipperLocalTransferCents', 'otherRecoverableCents', 'payingParticipants', 'updatedAt', 'updatedBy'])
        && request.resource.data.charterCents is int
        && request.resource.data.charterCents >= 0
        && request.resource.data.charterCents <= 1000000
        && request.resource.data.skipperFlightTrainCents is int
        && request.resource.data.skipperFlightTrainCents >= 0
        && request.resource.data.skipperFlightTrainCents <= 1000000
        && request.resource.data.skipperCarCents is int
        && request.resource.data.skipperCarCents >= 0
        && request.resource.data.skipperCarCents <= 1000000
        && request.resource.data.skipperLocalTransferCents is int
        && request.resource.data.skipperLocalTransferCents >= 0
        && request.resource.data.skipperLocalTransferCents <= 1000000
        && request.resource.data.otherRecoverableCents is int
        && request.resource.data.otherRecoverableCents >= 0
        && request.resource.data.otherRecoverableCents <= 1000000
        && request.resource.data.payingParticipants is int
        && request.resource.data.payingParticipants >= 1
        && request.resource.data.payingParticipants <= 30
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    // Piano quote, richieste personali e bacheca restano consultabili soltanto
    // dopo la conferma della versione corrente delle regole di bordo. Il
    // briefing rimane un percorso separato e leggibile prima, così la persona
    // può effettivamente leggerlo e accettarlo.
    function hasCurrentParticipantBriefingAcceptance(boatId) {
      return isBoatParticipant(boatId)
        && hasCurrentBriefingAcceptance(boatId,
          get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.inviteId);
    }

    function hasValidCollectionProfile() {
      return request.resource.data.keys().hasAll(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'paymentDetails', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'paymentDetails', 'updatedAt', 'updatedBy'])
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName is string
        && request.resource.data.collectorName.size() > 0
        && request.resource.data.collectorName.size() <= 100
        && request.resource.data.paypalEnabled is bool
        && request.resource.data.satispayEnabled is bool
        && request.resource.data.revolutEnabled is bool
        && request.resource.data.bankTransferEnabled is bool
        && (request.resource.data.paypalEnabled == true
          || request.resource.data.satispayEnabled == true
          || request.resource.data.revolutEnabled == true
          || request.resource.data.bankTransferEnabled == true)
        // È obbligatorio: un client precedente non può cancellare dettagli già
        // salvati riscrivendo il vecchio schema del profilo.
        && hasValidPaymentDetails(request.resource.data.paymentDetails)
        && (!request.resource.data.paypalEnabled || isHttpsPaymentLink(request.resource.data.paymentDetails.paypal))
        && (!request.resource.data.satispayEnabled || isHttpsPaymentLink(request.resource.data.paymentDetails.satispay))
        && (!request.resource.data.revolutEnabled || isValidRevolutDestination(request.resource.data.paymentDetails.revolut))
        && (!request.resource.data.bankTransferEnabled
          || (request.resource.data.paymentDetails.bankTransfer.iban != ''
            && request.resource.data.paymentDetails.bankTransfer.accountHolder != ''))
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function collectionProfileExists(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default);
    }

    function inviteExists(boatId, inviteId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId));
    }

    function paymentMethodsAllowedByProfile(boatId, methods) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return hasValidPaymentDetails(profile.paymentDetails)
        && (!methods.keys().hasAll(['paypal'])
          || (profile.paypalEnabled == true && isHttpsPaymentLink(profile.paymentDetails.paypal)))
        && (!methods.keys().hasAll(['satispay'])
          || (profile.satispayEnabled == true && isHttpsPaymentLink(profile.paymentDetails.satispay)))
        && (!methods.keys().hasAll(['revolut'])
          || (profile.revolutEnabled == true && isValidRevolutDestination(profile.paymentDetails.revolut)))
        && (!methods.keys().hasAll(['bankTransfer'])
          || (profile.bankTransferEnabled == true
            && profile.paymentDetails.bankTransfer.iban != ''
            && profile.paymentDetails.bankTransfer.accountHolder != ''));
    }

    // Etichetta tecnica chiusa: serve soltanto a separare i versamenti
    // verificati che recuperano i costi della barca dalle altre richieste.
    // Non contiene causali, coordinate o istruzioni di pagamento.
    function hasValidPaymentAccountingCategory(category) {
      return category is string
        && (category == 'cost_recovery' || category == 'other');
    }

    // Identificatore chiuso della voce richiesta. Permette al destinatario di
    // distinguere la propria quota, Starter Pack e assicurazione senza usare
    // o interpretare la causale libera del messaggio.
    function hasValidPaymentContributionItemId(itemId) {
      return itemId is string
        && itemId in ['berth_base', 'berth_double_cabin', 'berth_single_cabin', 'berth_dinette', 'berth_other', 'starter_pack', 'linen_towels', 'protection_insurance', 'provisions', 'fuel', 'transfer', 'other'];
    }

    function isValidPaymentRequestCreate(boatId) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return request.resource.data.keys().hasAll(['recipientId', 'memberId', 'payerInviteId', 'amountCents', 'currency', 'reason', 'accountingCategory', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.keys().hasOnly(['recipientId', 'memberId', 'payerInviteId', 'contributionItemId', 'amountCents', 'currency', 'reason', 'accountingCategory', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.memberId == request.resource.data.recipientId
        && request.resource.data.payerInviteId == request.resource.data.recipientId
        && inviteExists(boatId, request.resource.data.recipientId)
        // Compatibilità temporanea per pagine skipper già aperte prima del
        // selettore tecnico: se la chiave è presente deve comunque essere
        // nell'enum chiuso. `refundable_deposit` non è mai ammesso online.
        && (!request.resource.data.keys().hasAll(['contributionItemId'])
          || hasValidPaymentContributionItemId(request.resource.data.contributionItemId))
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 1
        && request.resource.data.amountCents <= 1000000
        && request.resource.data.currency == 'EUR'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 160
        && hasValidPaymentAccountingCategory(request.resource.data.accountingCategory)
        && request.resource.data.isOptional is bool
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() <= 10
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName == profile.collectorName
        && hasValidPaymentMethodSelection(request.resource.data.paymentMethods)
        && paymentMethodsAllowedByProfile(boatId, request.resource.data.paymentMethods)
        && request.resource.data.status == 'prepared'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verifiedAt == null
        && request.resource.data.verifiedBy == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.cancelledBy == null;
    }

    function canVerifyPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'verifiedBy']);
    }

    function canCancelPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);
    }

    // La vetrina pubblica non riusa mai /boats: quel documento contiene
    // identificativi tecnici e metadati privati. Una mappa privata e
    // immutabile lega l'ID casuale al solo skipper che l'ha creato.
    function isPublicFleetOwner(publicId) {
      return isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && existsAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId))
        && getAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId)).data.skipperId == request.auth.uid;
    }

    function matchesPrivateFleetBoat(publicId) {
      return existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId
        && request.resource.data.name == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.name
        && request.resource.data.model == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.model
        && request.resource.data.boatType == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.boatType
        && request.resource.data.skipperName == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperName
        && request.resource.data.capacity == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.capacity;
    }

    function hasValidPublicFleetProfile() {
      return request.resource.data.keys().hasAll(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 100
        && request.resource.data.boatType in ['Catamarano', 'Monoscafo', 'Gommone', 'Altro']
        && request.resource.data.skipperName is string
        && request.resource.data.skipperName.size() > 0
        && request.resource.data.skipperName.size() <= 100
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 30
        && request.resource.data.showAvailability is bool
        && request.resource.data.berthPreference in ['not_specified', 'cabin_female', 'cabin_male', 'cabin_mixed', 'dinette', 'other']
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.showAvailability == true
          && request.resource.data.availableSeats is int
          && request.resource.data.availableSeats >= 0
          && request.resource.data.availableSeats <= request.resource.data.capacity)
          || (request.resource.data.showAvailability == false
            && request.resource.data.availableSeats == null
            && request.resource.data.berthPreference == 'not_specified'));
    }

    match /events/egadi-2026 {
      // Anche il documento evento resta non leggibile dall'area privata chiusa.
      allow read: if isPrivateAreaOpen() && isOrganizer();
      allow write: if isOrganizer();
    }

    match /events/egadi-2026/publicFleet/{publicId} {
      // Dati dichiarati dallo skipper per la sola vetrina: nessun contatto,
      // UID, ID barca, invito, Crew List o pagamento è presente qui.
      allow get, list: if isPublicFleetEnabled();
      allow create, update: if isPrivateAreaOpen()
        && isPublicFleetOwner(publicId)
        && matchesPrivateFleetBoat(publicId)
        && hasValidPublicFleetProfile();
      allow delete: if isPrivateAreaOpen() && (isOrganizer() || isPublicFleetOwner(publicId));
    }

    match /events/egadi-2026/publicFleetOwners/{publicId} {
      // È un legame tecnico non leggibile dal web: non contiene alcun dato
      // Crew List e, dopo la creazione, può solo essere riscritto identico.
      allow create: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasAll(['skipperId'])
        && request.resource.data.keys().hasOnly(['skipperId'])
        && request.resource.data.skipperId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId;
      allow update: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && resource.data.skipperId == request.auth.uid
        && request.resource.data == resource.data;
      allow read, delete: if false;
    }

    // Indice pseudonimo: non contiene nome, telefono o Crew List. È creato
    // solo dopo l'attivazione e serve a risalire all'account dal numero inserito.
    match /crewLoginIndex/{phoneFingerprint} {
      allow get: if isPrivateAreaOpen();
      allow list: if false;
      allow create: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint);
      allow update: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint)
        && resource.data.boatId == request.resource.data.boatId
        && resource.data.inviteId == request.resource.data.inviteId;
      allow delete: if false;
    }

    match /crewAccess/{userId} {
      allow get: if isPrivateAreaOpen() && isCurrentCrewAccess(userId);
      allow list: if false;
      allow create, update: if isPrivateAreaOpen() && isValidCrewAccess(userId);
      allow delete: if false;
    }

    match /boats/{boatId} {
      // La pagina skipper legge esclusivamente /boats/{proprio UID}. Se il
      // documento non esiste, la lettura puntuale serve solo a mostrare la
      // registrazione; se esiste, resta leggibile al solo vero proprietario.
      allow get: if isPrivateAreaOpen() && (isOrganizer()
        || (isGoogleSkipperAccount() && boatId == request.auth.uid
          && (!exists(/databases/$(database)/documents/boats/$(boatId))
            || get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid)));
      allow list: if false;
      allow create: if isPrivateAreaOpen() && isGoogleSkipperAccount() && boatId == request.auth.uid && request.resource.data.skipperId == request.auth.uid && hasValidPrivateBoatCapacity();
      allow update: if isPrivateAreaOpen() && (isOrganizer() || (isSkipper(boatId)
        && request.resource.data.skipperId == resource.data.skipperId
        && request.resource.data.eventId == resource.data.eventId
        // L'ID della vetrina può essere aggiunto alla barca legacy una sola
        // volta, poi resta immutabile per non sostituire una card esistente.
        && (!resource.data.keys().hasAll(['publicFleetId'])
          || request.resource.data.publicFleetId == resource.data.publicFleetId)
        && hasValidPrivateBoatCapacity()));
      allow delete: if isPrivateAreaOpen() && isOrganizer();

      match /invites/{inviteId} {
        // Il link è un codice di attivazione, non l'accesso quotidiano.
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId)) && isValidNewInvite(boatId, inviteId);
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow update: if isPrivateAreaOpen() && (canClaimInvite(boatId, inviteId)
          || ((isOrganizer() || isSkipper(boatId)) && canReissueInvite(boatId, inviteId)));
      }

      // Posto e preventivo restano privati finché lo skipper non invia il
      // link personale. L'equipaggio attivo può leggere soltanto il proprio
      // documento puntuale: mai la lista, mai le proiezioni altrui.
      match /crewProjections/{projectionId} {
        allow get: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, projectionId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionCreate(projectionId);
        allow update: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionDraftUpdate(projectionId);
        allow update: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && isValidCrewProjectionInviteTransition(boatId, projectionId);
        // Si libera solo una bozza senza accesso. Dopo l'invito il record
        // resta la traccia privata che collega lo stesso posto alla Crew List.
        allow delete: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId))
          && resource.data.status == 'projected'
          && resource.data.inviteId == null
          && resource.data.invitedAt == null;
      }

      match /members/{memberId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId));
        allow create: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberCreate())
          || isValidCrewMemberCreate(boatId, memberId));
        allow update: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberUpdate())
          || isValidCrewMemberUpdate(boatId, memberId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      // Percorso legacy: il nuovo accesso usa soltanto /crewAccess/{uid}.
      match /participantAccess/{userId} {
        allow read, write: if false;
      }

      // Il profilo è privato allo skipper e conserva istruzioni di incasso
      // non segrete. Non contiene password, OTP, carte o credenziali provider.
      match /collectionProfile/{profileId} {
        allow get: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId) && hasValidCollectionProfile();
        allow delete: if false;
      }

      // Riepilogo leggibile dall'equipaggio già confermato. È separato dal
      // profilo di incasso privato e contiene solo otto voci standardizzate,
      // stato e importo eventuale: mai link, IBAN o istruzioni di pagamento.
      match /contributionPlan/{planId} {
        allow get: if isPrivateAreaOpen()
          && planId == 'default'
          && (isOrganizer()
            || isSkipper(boatId)
            || hasCurrentParticipantBriefingAcceptance(boatId));
        allow list: if false;
        allow create, update: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && hasValidContributionPlan();
        allow delete: if false;
      }

      // Il prospetto interno della cassa skipper non è una comunicazione
      // all'equipaggio: anche l'organizzatore non lo legge o modifica. Lo
      // skipper può soltanto usare il documento standard /default.
      match /costPlan/{planId} {
        allow get: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId);
        allow list: if false;
        allow create, update: if isPrivateAreaOpen()
          && planId == 'default'
          && isSkipper(boatId)
          && hasValidSkipperCostPlan();
        allow delete: if false;
      }

      match /paymentRequests/{requestId} {
        // Le richieste e la loro categoria contabile alimentano soltanto la
        // contabilità privata dello skipper: l'organizzatore non le legge né
        // può alterare il pareggio della Cassa skipper.
        allow read: if isPrivateAreaOpen()
          && (isSkipper(boatId)
            || (resource.data.recipientId is string
              && isInviteHolder(boatId, resource.data.recipientId)
              && hasCurrentParticipantBriefingAcceptance(boatId)));
        allow create: if isPrivateAreaOpen() && isSkipper(boatId) && collectionProfileExists(boatId) && isValidPaymentRequestCreate(boatId);
        allow update: if isPrivateAreaOpen() && isSkipper(boatId) && (canVerifyPayment() || canCancelPayment());
        allow delete: if false;
      }

      match /briefing/{briefingId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId));
        allow create: if isPrivateAreaOpen() && briefingId == 'board' && (isOrganizer() || isSkipper(boatId)) && isValidBoardBriefingCreate();
        allow update: if isPrivateAreaOpen() && briefingId == 'board' && (isOrganizer() || isSkipper(boatId)) && isValidBoardBriefingUpdate();
        allow delete: if false;
      }

      match /announcements/{announcementId} {
        allow read: if isPrivateAreaOpen()
          && (isOrganizer() || isSkipper(boatId) || hasCurrentParticipantBriefingAcceptance(boatId));
        allow create, update, delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      match /ruleAcceptances/{inviteId} {
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create, update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));

        match /history/{versionId} {
          allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
          allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
          allow update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        }
      }
    }
  }
}
