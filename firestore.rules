rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isPasswordCrew() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'password'
        && request.auth.token.email is string;
    }

    function isGoogleSkipperAccount() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    function isOrganizer() {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/events/egadi-2026).data.organizerIds;
    }

    // L'area privata resta negata di default. Il titolare la apre soltanto
    // dopo informativa definitiva, test Rules e test browser separati.
    function isPrivateAreaOpen() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.privateAreaEnabled == true;
    }

    // Interruttore indipendente: la vetrina pubblica può essere spenta senza
    // toccare gli accessi privati di skipper ed equipaggi.
    function isPublicFleetEnabled() {
      return exists(/databases/$(database)/documents/events/egadi-2026)
        && get(/databases/$(database)/documents/events/egadi-2026).data.publicFleetEnabled == true;
    }

    function isSkipper(boatId) {
      return isGoogleSkipperAccount()
        && exists(/databases/$(database)/documents/boats/$(boatId))
        && get(/databases/$(database)/documents/boats/$(boatId)).data.skipperId == request.auth.uid;
    }

    function isInviteHolder(boatId, inviteId) {
      return signedIn()
        && exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId))
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.status == 'active'
        && get(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId)).data.participantUid == request.auth.uid;
    }

    function hasValidMemberPayload() {
      return request.resource.data.keys().hasAll(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy', 'createdAt', 'createdBy'])
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.birthDate is string
        && request.resource.data.birthPlace is string
        && request.resource.data.nationality is string
        && request.resource.data.gender is string
        && request.resource.data.documentType is string
        && request.resource.data.documentNumber is string
        && request.resource.data.documentExpiry is string
        && request.resource.data.role is string
        && (!request.resource.data.keys().hasAll(['roleConfirmed']) || request.resource.data.roleConfirmed is bool)
        && request.resource.data.email is string
        && request.resource.data.phone is string
        && request.resource.data.charterConsent is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName == request.resource.data.firstName + ' ' + request.resource.data.lastName
        && request.resource.data.updatedAt == request.time;
    }

    function isValidOwnerMemberCreate() {
      return hasValidMemberPayload()
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function isValidOwnerMemberUpdate() {
      return hasValidMemberPayload()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt']);
    }

    function isValidCrewMemberCreate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.keys().hasAll(['roleConfirmed'])
        && request.resource.data.roleConfirmed == false
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function hasSafeCrewRoleConfirmation() {
      return (request.resource.data.role == resource.data.role
          && ((!resource.data.keys().hasAll(['roleConfirmed']) && !request.resource.data.keys().hasAll(['roleConfirmed']))
            || (resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == resource.data.roleConfirmed)
            || (!resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.keys().hasAll(['roleConfirmed'])
              && request.resource.data.roleConfirmed == false)))
        || (request.resource.data.role != resource.data.role
          && request.resource.data.keys().hasAll(['roleConfirmed'])
          && request.resource.data.roleConfirmed == false);
    }

    function isValidCrewMemberUpdate(boatId, memberId) {
      return isInviteHolder(boatId, memberId)
        && hasValidMemberPayload()
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['firstName', 'lastName', 'birthDate', 'birthPlace', 'nationality', 'gender', 'documentType', 'documentNumber', 'documentExpiry', 'role', 'roleConfirmed', 'email', 'phone', 'charterConsent', 'displayName', 'updatedAt', 'updatedBy'])
        && hasSafeCrewRoleConfirmation();
    }

    function isValidNewInvite(boatId, inviteId) {
      return request.resource.data.keys().hasAll(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'createdAt', 'createdBy'])
        && request.resource.data.keys().hasOnly(['id', 'boatId', 'displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'createdAt', 'createdBy'])
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.participantUid == null
        && request.resource.data.status == 'pending'
        && request.resource.data.accessVersion == 1
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid;
    }

    function canClaimInvite(boatId, inviteId) {
      return isPasswordCrew()
        && resource.data.id == inviteId
        && resource.data.boatId == boatId
        && resource.data.status == 'pending'
        && resource.data.participantUid == null
        && resource.data.expiresAt > request.time
        && resource.data.loginEmail == request.auth.token.email
        && request.resource.data.participantUid == request.auth.uid
        && request.resource.data.status == 'active'
        && request.resource.data.activatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantUid', 'status', 'activatedAt']);
    }

    function canReissueInvite(boatId, inviteId) {
      return resource.data.id == inviteId
        && resource.data.boatId == boatId
        && request.resource.data.id == inviteId
        && request.resource.data.boatId == boatId
        && request.resource.data.displayName is string
        && request.resource.data.whatsappNumber is string
        && request.resource.data.phoneFingerprint is string
        && request.resource.data.loginEmail is string
        && request.resource.data.accessKey is string
        && request.resource.data.accessKey.size() == 48
        && request.resource.data.status == 'pending'
        && request.resource.data.participantUid == null
        && request.resource.data.accessVersion is int
        && ((resource.data.keys().hasAll(['accessVersion'])
          && resource.data.accessVersion is int
          && request.resource.data.accessVersion == resource.data.accessVersion + 1)
          || (!resource.data.keys().hasAll(['accessVersion'])
            && request.resource.data.accessVersion == 1))
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt > request.time
        && request.resource.data.reissuedAt == request.time
        && request.resource.data.reissuedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'whatsappNumber', 'phoneFingerprint', 'loginEmail', 'accessKey', 'participantUid', 'status', 'accessVersion', 'expiresAt', 'activatedAt', 'reissuedAt', 'reissuedBy']);
    }

    function isCurrentCrewAccess(userId) {
      return signedIn()
        && userId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && resource.data.loginEmail == request.auth.token.email
        && resource.data.boatId is string
        && resource.data.inviteId is string
        && isInviteHolder(resource.data.boatId, resource.data.inviteId);
    }

    function isValidCrewAccess(userId) {
      return isPasswordCrew()
        && userId == request.auth.uid
        && request.resource.data.keys().hasAll(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['boatId', 'inviteId', 'userId', 'loginEmail', 'updatedAt'])
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId is string
        && request.resource.data.inviteId is string
        && request.resource.data.updatedAt == request.time
        && isInviteHolder(request.resource.data.boatId, request.resource.data.inviteId);
    }

    function isBoatParticipant(boatId) {
      return signedIn()
        && exists(/databases/$(database)/documents/crewAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.boatId == boatId
        && get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.userId == request.auth.uid
        && isInviteHolder(boatId, get(/databases/$(database)/documents/crewAccess/$(request.auth.uid)).data.inviteId);
    }

    function canWriteCrewLoginIndex(phoneFingerprint) {
      let access = get(/databases/$(database)/documents/crewAccess/$(request.auth.uid));
      let invite = get(/databases/$(database)/documents/boats/$(access.data.boatId)/invites/$(access.data.inviteId));
      return isPasswordCrew()
        && access.data.userId == request.auth.uid
        && access.data.loginEmail == request.auth.token.email
        && invite.data.status == 'active'
        && invite.data.participantUid == request.auth.uid
        && invite.data.phoneFingerprint == phoneFingerprint
        && request.resource.data.keys().hasAll(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['loginEmail', 'boatId', 'inviteId', 'updatedAt'])
        && request.resource.data.loginEmail == request.auth.token.email
        && request.resource.data.boatId == access.data.boatId
        && request.resource.data.inviteId == access.data.inviteId
        && request.resource.data.updatedAt == request.time;
    }

    function isValidRuleAcceptance(boatId, inviteId) {
      return isInviteHolder(boatId, inviteId)
        && request.resource.data.keys().hasOnly(['inviteId', 'acceptedBy', 'rulesVersion', 'acceptedAt'])
        && request.resource.data.inviteId == inviteId
        && request.resource.data.acceptedBy == request.auth.uid
        && request.resource.data.rulesVersion is int
        && request.resource.data.acceptedAt == request.time
        && exists(/databases/$(database)/documents/boats/$(boatId)/briefing/board)
        && request.resource.data.rulesVersion == get(/databases/$(database)/documents/boats/$(boatId)/briefing/board).data.rulesVersion;
    }

    function isPaymentManager(boatId) {
      return isOrganizer() || isSkipper(boatId);
    }

    function hasValidPaymentMethodSelection(methods) {
      return methods is map
        && methods.keys().hasOnly(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && methods.keys().hasAny(['paypal', 'satispay', 'revolut', 'bankTransfer'])
        && (!methods.keys().hasAll(['paypal']) || methods.paypal == true)
        && (!methods.keys().hasAll(['satispay']) || methods.satispay == true)
        && (!methods.keys().hasAll(['revolut']) || methods.revolut == true)
        && (!methods.keys().hasAll(['bankTransfer']) || methods.bankTransfer == true);
    }

    function hasValidCollectionProfile() {
      return request.resource.data.keys().hasAll(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'updatedAt', 'updatedBy'])
        && request.resource.data.keys().hasOnly(['collectorId', 'collectorName', 'paypalEnabled', 'satispayEnabled', 'revolutEnabled', 'bankTransferEnabled', 'updatedAt', 'updatedBy'])
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName is string
        && request.resource.data.collectorName.size() > 0
        && request.resource.data.collectorName.size() <= 100
        && request.resource.data.paypalEnabled is bool
        && request.resource.data.satispayEnabled is bool
        && request.resource.data.revolutEnabled is bool
        && request.resource.data.bankTransferEnabled is bool
        && (request.resource.data.paypalEnabled == true
          || request.resource.data.satispayEnabled == true
          || request.resource.data.revolutEnabled == true
          || request.resource.data.bankTransferEnabled == true)
        && request.resource.data.updatedAt == request.time
        && request.resource.data.updatedBy == request.auth.uid;
    }

    function collectionProfileExists(boatId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default);
    }

    function inviteExists(boatId, inviteId) {
      return exists(/databases/$(database)/documents/boats/$(boatId)/invites/$(inviteId));
    }

    function paymentMethodsAllowedByProfile(boatId, methods) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return (!methods.keys().hasAll(['paypal']) || profile.paypalEnabled == true)
        && (!methods.keys().hasAll(['satispay']) || profile.satispayEnabled == true)
        && (!methods.keys().hasAll(['revolut']) || profile.revolutEnabled == true)
        && (!methods.keys().hasAll(['bankTransfer']) || profile.bankTransferEnabled == true);
    }

    function isValidPaymentRequestCreate(boatId) {
      let profile = get(/databases/$(database)/documents/boats/$(boatId)/collectionProfile/default).data;
      return request.resource.data.keys().hasAll(['recipientId', 'memberId', 'payerInviteId', 'amountCents', 'currency', 'reason', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.keys().hasOnly(['recipientId', 'memberId', 'payerInviteId', 'amountCents', 'currency', 'reason', 'isOptional', 'dueDate', 'collectorId', 'collectorName', 'paymentMethods', 'status', 'createdAt', 'createdBy', 'verifiedAt', 'verifiedBy', 'cancelledAt', 'cancelledBy'])
        && request.resource.data.recipientId is string
        && request.resource.data.recipientId.size() > 0
        && request.resource.data.memberId == request.resource.data.recipientId
        && request.resource.data.payerInviteId == request.resource.data.recipientId
        && inviteExists(boatId, request.resource.data.recipientId)
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents >= 1
        && request.resource.data.amountCents <= 1000000
        && request.resource.data.currency == 'EUR'
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 160
        && request.resource.data.isOptional is bool
        && request.resource.data.dueDate is string
        && request.resource.data.dueDate.size() <= 10
        && request.resource.data.collectorId == request.auth.uid
        && request.resource.data.collectorName == profile.collectorName
        && hasValidPaymentMethodSelection(request.resource.data.paymentMethods)
        && paymentMethodsAllowedByProfile(boatId, request.resource.data.paymentMethods)
        && request.resource.data.status == 'prepared'
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.verifiedAt == null
        && request.resource.data.verifiedBy == null
        && request.resource.data.cancelledAt == null
        && request.resource.data.cancelledBy == null;
    }

    function canVerifyPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'verified'
        && request.resource.data.verifiedAt == request.time
        && request.resource.data.verifiedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'verifiedAt', 'verifiedBy']);
    }

    function canCancelPayment() {
      return (resource.data.status == 'prepared' || resource.data.status == 'requested')
        && request.resource.data.status == 'cancelled'
        && request.resource.data.cancelledAt == request.time
        && request.resource.data.cancelledBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledAt', 'cancelledBy']);
    }

    // La vetrina pubblica non riusa mai /boats: quel documento contiene
    // identificativi tecnici e metadati privati. Una mappa privata e
    // immutabile lega l'ID casuale al solo skipper che l'ha creato.
    function isPublicFleetOwner(publicId) {
      return isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && existsAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId))
        && getAfter(/databases/$(database)/documents/events/egadi-2026/publicFleetOwners/$(publicId)).data.skipperId == request.auth.uid;
    }

    function matchesPrivateFleetBoat(publicId) {
      return existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId
        && request.resource.data.name == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.name
        && request.resource.data.model == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.model
        && request.resource.data.boatType == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.boatType
        && request.resource.data.skipperName == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperName
        && request.resource.data.capacity == getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.capacity;
    }

    function hasValidPublicFleetProfile() {
      return request.resource.data.keys().hasAll(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'model', 'boatType', 'skipperName', 'capacity', 'showAvailability', 'availableSeats', 'berthPreference', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 70
        && request.resource.data.model is string
        && request.resource.data.model.size() > 0
        && request.resource.data.model.size() <= 100
        && request.resource.data.boatType in ['Catamarano', 'Monoscafo', 'Gommone', 'Altro']
        && request.resource.data.skipperName is string
        && request.resource.data.skipperName.size() > 0
        && request.resource.data.skipperName.size() <= 100
        && request.resource.data.capacity is int
        && request.resource.data.capacity >= 1
        && request.resource.data.capacity <= 30
        && request.resource.data.showAvailability is bool
        && request.resource.data.berthPreference in ['not_specified', 'cabin_female', 'cabin_male', 'dinette', 'crew_cabin', 'other']
        && request.resource.data.updatedAt == request.time
        && ((request.resource.data.showAvailability == true
          && request.resource.data.availableSeats is int
          && request.resource.data.availableSeats >= 0
          && request.resource.data.availableSeats <= request.resource.data.capacity)
          || (request.resource.data.showAvailability == false
            && request.resource.data.availableSeats == null
            && request.resource.data.berthPreference == 'not_specified'));
    }

    match /events/egadi-2026 {
      // Anche il documento evento resta non leggibile dall'area privata chiusa.
      allow read: if isPrivateAreaOpen() && isOrganizer();
      allow write: if isOrganizer();
    }

    match /events/egadi-2026/publicFleet/{publicId} {
      // Dati dichiarati dallo skipper per la sola vetrina: nessun contatto,
      // UID, ID barca, invito, Crew List o pagamento è presente qui.
      allow get, list: if isPublicFleetEnabled();
      allow create, update: if isPrivateAreaOpen()
        && isPublicFleetOwner(publicId)
        && matchesPrivateFleetBoat(publicId)
        && hasValidPublicFleetProfile();
      allow delete: if isPrivateAreaOpen() && (isOrganizer() || isPublicFleetOwner(publicId));
    }

    match /events/egadi-2026/publicFleetOwners/{publicId} {
      // È un legame tecnico non leggibile dal web: non contiene alcun dato
      // Crew List e, dopo la creazione, può solo essere riscritto identico.
      allow create: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && publicId.matches('^[a-f0-9]{48}$')
        && request.resource.data.keys().hasAll(['skipperId'])
        && request.resource.data.keys().hasOnly(['skipperId'])
        && request.resource.data.skipperId == request.auth.uid
        && existsAfter(/databases/$(database)/documents/boats/$(request.auth.uid))
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.skipperId == request.auth.uid
        && getAfter(/databases/$(database)/documents/boats/$(request.auth.uid)).data.publicFleetId == publicId;
      allow update: if isPrivateAreaOpen()
        && isGoogleSkipperAccount()
        && resource.data.skipperId == request.auth.uid
        && request.resource.data == resource.data;
      allow read, delete: if false;
    }

    // Indice pseudonimo: non contiene nome, telefono o Crew List. È creato
    // solo dopo l'attivazione e serve a risalire all'account dal numero inserito.
    match /crewLoginIndex/{phoneFingerprint} {
      allow get: if isPrivateAreaOpen();
      allow list: if false;
      allow create: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint);
      allow update: if isPrivateAreaOpen() && canWriteCrewLoginIndex(phoneFingerprint)
        && resource.data.boatId == request.resource.data.boatId
        && resource.data.inviteId == request.resource.data.inviteId;
      allow delete: if false;
    }

    match /crewAccess/{userId} {
      allow get: if isPrivateAreaOpen() && isCurrentCrewAccess(userId);
      allow list: if false;
      allow create, update: if isPrivateAreaOpen() && isValidCrewAccess(userId);
      allow delete: if false;
    }

    match /boats/{boatId} {
      allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      allow create: if isPrivateAreaOpen() && isGoogleSkipperAccount() && boatId == request.auth.uid && request.resource.data.skipperId == request.auth.uid;
      allow update: if isPrivateAreaOpen() && (isOrganizer() || (isSkipper(boatId)
        && request.resource.data.skipperId == resource.data.skipperId
        && request.resource.data.eventId == resource.data.eventId
        // L'ID della vetrina può essere aggiunto alla barca legacy una sola
        // volta, poi resta immutabile per non sostituire una card esistente.
        && (!resource.data.keys().hasAll(['publicFleetId'])
          || request.resource.data.publicFleetId == resource.data.publicFleetId)));
      allow delete: if isPrivateAreaOpen() && isOrganizer();

      match /invites/{inviteId} {
        // Il link è un codice di attivazione, non l'accesso quotidiano.
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId)) && isValidNewInvite(boatId, inviteId);
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow update: if isPrivateAreaOpen() && (canClaimInvite(boatId, inviteId)
          || ((isOrganizer() || isSkipper(boatId)) && canReissueInvite(boatId, inviteId)));
      }

      match /members/{memberId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, memberId));
        allow create: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberCreate())
          || isValidCrewMemberCreate(boatId, memberId));
        allow update: if isPrivateAreaOpen() && (((isOrganizer() || isSkipper(boatId)) && isValidOwnerMemberUpdate())
          || isValidCrewMemberUpdate(boatId, memberId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      // Percorso legacy: il nuovo accesso usa soltanto /crewAccess/{uid}.
      match /participantAccess/{userId} {
        allow read, write: if false;
      }

      // Il profilo conserva soltanto il nome mostrato e i tag dei metodi.
      // Link, alias, coordinate e credenziali restano fuori da Firestore.
      match /collectionProfile/{profileId} {
        allow get: if isPrivateAreaOpen() && profileId == 'default' && (isOrganizer() || isSkipper(boatId));
        allow list: if false;
        allow create, update: if isPrivateAreaOpen() && profileId == 'default' && isSkipper(boatId) && hasValidCollectionProfile();
        allow delete: if false;
      }

      match /paymentRequests/{requestId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || (resource.data.recipientId is string && isInviteHolder(boatId, resource.data.recipientId)));
        allow create: if isPrivateAreaOpen() && isSkipper(boatId) && collectionProfileExists(boatId) && isValidPaymentRequestCreate(boatId);
        allow update: if isPrivateAreaOpen() && isPaymentManager(boatId) && (canVerifyPayment() || canCancelPayment());
        allow delete: if false;
      }

      match /briefing/{briefingId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId));
        allow create, update, delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      match /announcements/{announcementId} {
        allow read: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isBoatParticipant(boatId));
        allow create, update, delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
      }

      match /ruleAcceptances/{inviteId} {
        allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
        allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        allow create, update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
        allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));

        match /history/{versionId} {
          allow get: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isInviteHolder(boatId, inviteId));
          allow list: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow create: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId) || isValidRuleAcceptance(boatId, inviteId));
          allow update: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
          allow delete: if isPrivateAreaOpen() && (isOrganizer() || isSkipper(boatId));
        }
      }
    }
  }
}
